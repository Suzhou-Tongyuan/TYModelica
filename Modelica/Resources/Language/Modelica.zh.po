msgctxt "Modelica.Electrical.QuasiStatic.Polyphase.Basic"
msgid "Basic components for AC polyphase models"
msgstr "交流多相的基本组件"

msgctxt "Modelica.Electrical.QuasiStatic.Polyphase.Basic"
msgid "<html>\r\n"
"<p>This package hosts basic models for quasi-static polyphase circuits.\r\n"
"Quasi-static theory can be found in the\r\n"
"<a href=\"modelica://Modelica.Electrical.QuasiStatic.UsersGuide.References\">references</a>.\r\n"
"</p>\r\n"
"<h4>See also</h4>\r\n"
"\r\n"
"<a href=\"modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Basic\">SinglePhase.Basic</a>\r\n"
"\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>此包托管了准静态多相电路的基本模型。\r\n"
"准静态理论可以在\r\n"
"<a href=\"modelica://Modelica.Electrical.QuasiStatic.UsersGuide.References\">参考资料</a>\r\n"
"中找到。\r\n"
"</p>\r\n"
"<h4>参见</h4>\r\n"
"\r\n"
"<a href=\"modelica://Modelica.Electrical.QuasiStatic.SinglePhase.Basic\">SinglePhase.Basic</a>\r\n"
"\r\n"
"</html>"

