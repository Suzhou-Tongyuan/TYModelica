msgctxt "Modelica.Electrical.Analog.Ideal.IdealTriac"
msgid "Ideal triac, based on ideal thyristors"
msgstr "理想双向可控硅(基于理想晶闸管)"

msgctxt "Modelica.Electrical.Analog.Ideal.IdealTriac"
