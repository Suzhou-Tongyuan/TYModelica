msgstr "功能选择，默认为高电平复位"

msgctxt "Modelica.Electrical.Digital.Registers.DFFR"
msgid "Output strength"
msgstr "输出强度"

msgctxt "Modelica.Electrical.Digital.Registers.DFFR"
msgid "Data width"
msgstr "数据宽度"

msgctxt "Modelica.Electrical.Digital.Registers.DFFR"
msgid "DFFR"
msgstr "DFFR"

msgctxt "Modelica.Electrical.Digital.Registers.DFFR"
msgid "clock"
msgstr "clock"

msgctxt "Modelica.Electrical.Digital.Registers.DFFR"
msgid "reset"
msgstr "reset"

msgctxt "Modelica.Electrical.Digital.Registers.DFFR"
msgid "<html>\r\n"
"<p>Description in VHDL is given by http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities</p>\r\n"
"<p><strong>Truth Table for high active reset:</strong></p>\r\n"
"\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"  <tr><td><strong>DataIn</strong></td>\r\n"
"      <td><strong>Clock</strong></td>\r\n"
"      <td><strong>Reset</strong></td>\r\n"
"      <td><strong>DataOut</strong></td>\r\n"
"      <td>Map</td>\r\n"
"  </tr>\r\n"
"\r\n"
"  <tr><td>*</td> <td>*</td> <td>U</td>  <td>U</td> <td>1</td> </tr>\r\n"
"  <tr><td>*</td> <td>*</td> <td>1</td>  <td>0</td> <td>2</td> </tr>\r\n"
"  <tr><td>*</td> <td>0-Trns</td> <td>0</td>  <td>NC</td> <td>3</td> </tr>\r\n"
"  <tr><td>*</td> <td>1-Trns</td> <td>0</td>  <td>DataIn</td> <td>3</td> </tr>\r\n"
"  <tr><td>*</td> <td>X-Trns</td> <td>0</td>  <td>X or U or NC</td> <td>3</td> </tr>\r\n"
"  <tr><td>*</td> <td>*</td> <td>X</td> <td>X or U or 0 or NC</td> <td>4</td> </tr>\r\n"
"</table>\r\n"
"\r\n"
"<p><strong>Truth Table for low active reset:</strong></p>\r\n"
"\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"  <tr><td><strong>DataIn</strong></td>\r\n"
"      <td><strong>Clock</strong></td>\r\n"
"      <td><strong>Reset</strong></td>\r\n"
"      <td><strong>DataOut</strong></td>\r\n"
"      <td>Map</td>\r\n"
"  </tr>\r\n"
"\r\n"
"  <tr><td>*</td> <td>*</td> <td>U</td>  <td>U</td> <td>1</td> </tr>\r\n"
"  <tr><td>*</td> <td>*</td> <td>0</td>  <td>0</td> <td>2</td> </tr>\r\n"
"  <tr><td>*</td> <td>0-Trns</td> <td>1</td>  <td>NC</td> <td>3</td> </tr>\r\n"
"  <tr><td>*</td> <td>1-Trns</td> <td>1</td>  <td>DataIn</td> <td>3</td> </tr>\r\n"
"  <tr><td>*</td> <td>X-Trns</td> <td>1</td>  <td>X or U or NC</td> <td>3</td> </tr>\r\n"
"  <tr><td>*</td> <td>*</td> <td>X</td> <td>X or U or 0 or NC</td> <td>4</td> </tr>\r\n"
"</table>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"  *  = do not care\r\n"
"  U  = L.'U'\r\n"
"  0  = L.'0' or L.'L'\r\n"
"  1  = L.'1' or L.'H'\r\n"
"  X  = L.'X' or L.'W' or L.'Z' or L.'-'\r\n"
"  NC = no change\r\n"
"\r\n"
"Clock transition definitions:\r\n"
"  1-Trns: 0 -> 1\r\n"
"  0-Trns: ~ -> 0 or 1 -> * or X -> X|U or U -> X|U\r\n"
"  X-Trns: 0 -> X|U or X|U -> 1\r\n"
"</pre></blockquote>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>VHDL中的描述见 <a href=\"http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities\">http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities</a></p>\r\n"
"\r\n"
"<p><strong>高电平复位的真值表：</strong></p>\r\n"
"\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td><strong>DataIn</strong></td>\r\n"
"<td><strong>Clock</strong></td>\r\n"
"<td><strong>Reset</strong></td>\r\n"
"<td><strong>DataOut</strong></td>\r\n"
"<td>Map</td>\r\n"
"</tr>\r\n"
"\r\n"
"<tr><td>*</td> <td>*</td> <td>U</td>  <td>U</td> <td>1</td> </tr>\r\n"
"<tr><td>*</td> <td>*</td> <td>1</td>  <td>0</td> <td>2</td> </tr>\r\n"
"<tr><td>*</td> <td>0-转换</td> <td>0</td>  <td>NC</td> <td>3</td> </tr>\r\n"
"<tr><td>*</td> <td>1-转换</td> <td>0</td>  <td>DataIn</td> <td>3</td> </tr>\r\n"
"<tr><td>*</td> <td>X-转换</td> <td>0</td>  <td>X或U或NC</td> <td>3</td> </tr>\r\n"
"<tr><td>*</td> <td>*</td> <td>X</td> <td>X或U或0或NC</td> <td>4</td> </tr>\r\n"
"</table>\r\n"
"\r\n"
"<p><strong>低电平复位的真值表：</strong></p>\r\n"
"\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td><strong>DataIn</strong></td>\r\n"
"<td><strong>Clock</strong></td>\r\n"
"<td><strong>Reset</strong></td>\r\n"
"<td><strong>DataOut</strong></td>\r\n"
"<td>Map</td>\r\n"
"</tr>\r\n"
"\r\n"
"<tr><td>*</td> <td>*</td> <td>U</td>  <td>U</td> <td>1</td> </tr>\r\n"
"<tr><td>*</td> <td>*</td> <td>0</td>  <td>0</td> <td>2</td> </tr>\r\n"
"<tr><td>*</td> <td>0-转换</td> <td>1</td>  <td>NC</td> <td>3</td> </tr>\r\n"
"<tr><td>*</td> <td>1-转换</td> <td>1</td>  <td>DataIn</td> <td>3</td> </tr>\r\n"
"<tr><td>*</td> <td>X-转换</td> <td>1</td>  <td>X或U或NC</td> <td>3</td> </tr>\r\n"
"<tr><td>*</td> <td>*</td> <td>X</td> <td>X或U或0或NC</td> <td>4</td> </tr>\r\n"
"</table>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"*  = 不关心\r\n"
"U  = L.'U'\r\n"
