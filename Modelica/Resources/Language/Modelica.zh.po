msgctxt "Modelica.Mechanics.MultiBody.Types"
msgid "Rotating frame_a around an angle with a fixed axis"
msgstr "围绕固定轴在角度上旋转frame_a"

msgctxt "Modelica.Mechanics.MultiBody.Types"
msgid "Resolve two vectors of frame_b in frame_a"
msgstr "在frame_a中解析frame_b的两个矢量"

msgctxt "Modelica.Mechanics.MultiBody.Types"
msgid "Planar rotation sequence"
msgstr "平面旋转序列"

msgctxt "Modelica.Mechanics.MultiBody.Types"
msgid "Enumeration defining in which way the fixed orientation of frame_b with respect to frame_a is specified"
msgstr "枚举类型，定义了frame_b相对于frame_a的固定方向的指定方式"

msgctxt "Modelica.Mechanics.MultiBody.Types"
msgid "<html>\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><th><strong>Types.RotationTypes.</strong></th><th><strong>Meaning</strong></th></tr>\r\n"
"<tr><td>RotationAxis</td>\r\n"
"    <td>frame_b is defined by rotating the coordinate system along\r\n"
"        an axis fixed in frame_a and with a fixed angle.</td></tr>\r\n"
"\r\n"
"<tr><td>TwoAxesVectors</td>\r\n"
"    <td>frame_b is defined by resolving two vectors of frame_b in frame_a.</td></tr>\r\n"
"\r\n"
"<tr><td>PlanarRotationSequence</td>\r\n"
"    <td>frame_b is defined by rotating the coordinate system along\r\n"
"        3 consecutive axes vectors with fixed rotation angles\r\n"
"        (e.g., Cardan or Euler angle sequence rotation).</td></tr>\r\n"
"</table>\r\n"
"</html>"
msgstr "<html>\r\n"
"<table border=\"1\"cellspacing=\"0\"cellpadding=\"2\">\r\n"
"<tr><th><strong>Types.RotationTypes.</strong></th><th><strong>含义</strong></th></tr>\r\n"
"<tr><td>RotationAxis</td>\r\n"
"<td>通过沿着frame_a中固定轴的角度旋转坐标系来定义frame_b。\r\n"
"</td></tr>\r\n"
"\r\n"
"<tr><td>TwoAxesVectors</td>\r\n"
"<td>通过在frame_a中解析frame_b的两个矢量来定义frame_b。\r\n"
"</td></tr>\r\n"
"\r\n"
"<tr><td>PlanarRotationSequence</td>\r\n"
"<td>通过沿着3个连续的固定旋转角度的轴矢量旋转坐标系来定义frame_b\r\n"
"(例如，Cardan或Euler角序列旋转)。\r\n"
"</td></tr>\r\n"
"</table>\r\n"
"</html>"

msgctxt "Modelica.Mechanics.MultiBody.Types"
