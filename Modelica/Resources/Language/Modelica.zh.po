msgctxt "Modelica.Electrical.Analog.Ideal.IdealDiode"
msgid "Ideal diode"
msgstr "理想二极管"

msgctxt "Modelica.Electrical.Analog.Ideal.IdealDiode"
msgid "<html>\r\n"
"<p>\r\n"
"This is an ideal diode, for details see partial model <a href=\"modelica://Modelica.Electrical.Analog.Interfaces.IdealSemiconductor\">IdealSemiconductor</a><br>\r\n"
"The diode is conducting if voltage &gt; Vknee.<br>\r\n"
"The diode is locking if current &lt; Vknee*Goff.\r\n"
"</p>\r\n"
"</html>"
