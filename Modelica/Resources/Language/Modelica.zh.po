msgctxt "Modelica.Electrical.Analog.Examples.Rectifier"
msgid "B6 diode bridge"
msgstr "B6型桥式连接二极管"

msgctxt "Modelica.Electrical.Analog.Examples.Rectifier"
msgid "RMS line-to-line"
msgstr "电路中线对线的有效值(电压)"

msgctxt "Modelica.Electrical.Analog.Examples.Rectifier"
