msgctxt "Modelica.Mechanics.MultiBody.Joints.Assemblies.JointSSP"
msgid "Relative distance offset of prismatic joint (distance between frame_b and frame_ib = s(t) + s_offset)"
msgstr "平移副的相对距离偏移(frame_b和frame_ib之间的距离=s(t)+s_offset)"

