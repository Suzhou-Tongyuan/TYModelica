msgctxt "Modelica.Blocks.Types"
msgid "Enumeration defining the smoothness of table interpolation"
msgstr "枚举定义表格插值的平滑度"

msgctxt "Modelica.Blocks.Types"
msgid "Hold the first/last table point outside of the table scope"
msgstr "保持第一个/最后一个表数据点在表范围之外"

msgctxt "Modelica.Blocks.Types"
msgid "Extrapolate by using the derivative at the first/last table points outside of the table scope"
msgstr "使用第一个/最后一个表数据点的导数进行外推"

msgctxt "Modelica.Blocks.Types"
msgid "Repeat the table scope periodically"
msgstr "周期性地重复表格范围"

msgctxt "Modelica.Blocks.Types"
msgid "Extrapolation triggers an error"
msgstr "外推触发错误"

msgctxt "Modelica.Blocks.Types"
msgid "Enumeration defining the extrapolation of table interpolation"
msgstr "枚举定义表格内插外推法的种类"

msgctxt "Modelica.Blocks.Types"
msgid "Always generate time events at interval boundaries"
msgstr "始终在间隔边界生成时间事件"

msgctxt "Modelica.Blocks.Types"
msgid "Generate time events at discontinuities (defined by duplicated sample points)"
msgstr "在不连续处(由重复采样点定义)生成时间事件"

msgctxt "Modelica.Blocks.Types"
msgid "No time events at interval boundaries"
msgstr "区间边界无时间事件"

msgctxt "Modelica.Blocks.Types"
msgid "Enumeration defining the time event handling of time table interpolation"
msgstr "枚举定义时间事件处理的时间表插值"

msgctxt "Modelica.Blocks.Types"
msgid "No initialization (start values are used as guess values with fixed=false)"
msgstr "无初始化(在固定值=false时，将起始值用作猜测值)"

msgctxt "Modelica.Blocks.Types"
msgid "Steady state initialization (derivatives of states are zero)"
msgstr "稳态初始化(状态导数为零)"

msgctxt "Modelica.Blocks.Types"
msgid "Initialization with initial states"
msgstr "初始状态初始化"

msgctxt "Modelica.Blocks.Types"
msgid "Initialization with initial outputs (and steady state of the states if possible)"
msgstr "初始输出值初始化(以及可能的稳态初始化)"

msgctxt "Modelica.Blocks.Types"
msgid "Enumeration defining initialization of a block"
msgstr "枚举定义区模块初始化的类型"

msgctxt "Modelica.Blocks.Types"
msgid "<html>\r\n"
"  <p>The following initialization alternatives are available:</p>\r\n"
"  <dl>\r\n"
"    <dt><code><strong>NoInit</strong></code></dt>\r\n"
"      <dd>No initialization (start values are used as guess values with <code>fixed=false</code>)</dd>\r\n"
"    <dt><code><strong>SteadyState</strong></code></dt>\r\n"
"      <dd>Steady state initialization (derivatives of states are zero)</dd>\r\n"
"    <dt><code><strong>InitialState</strong></code></dt>\r\n"
"      <dd>Initialization with initial states</dd>\r\n"
"    <dt><code><strong>InitialOutput</strong></code></dt>\r\n"
"      <dd>Initialization with initial outputs (and steady state of the states if possible)</dd>\r\n"
"  </dl>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>初始化选项如下：</p>\r\n"
"<dl>\r\n"
"<dt><code><strong>无初始化</strong></code></dt>\r\n"
"  <dd>无初始化(在<code>固定值=false</code>时，将起始值用作猜测值)</dd>\r\n"
"<dt><code><strong>稳态初始化</strong></code></dt>\r\n"
"  <dd>稳态初始化(状态导数为零)</dd>\r\n"
"<dt><code><strong>初始状态初始化</strong></code></dt>\r\n"
"  <dd>初始状态初始化</dd>\r\n"
"<dt><code><strong>初始输出值初始化</strong></code></dt>\r\n"
"  <dd>初始输出值初始化(以及可能的稳态初始化)</dd>\r\n"
"</dl>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Types"
msgid "Do not use, only for backward compatibility (initialize only integrator state)"
msgstr "不使用，仅用于向后兼容(仅初始化积分模块状态)"

msgctxt "Modelica.Blocks.Types"
msgid "Enumeration defining initialization of PID and LimPID blocks"
msgstr "枚举定义PID和LimPID模块初始化的种类"

msgctxt "Modelica.Blocks.Types"
msgid "<html>\r\n"
"<p>\r\n"
"This initialization type is identical to <a href=\"modelica://Modelica.Blocks.Types.Init\">Types.Init</a> and has just one\r\n"
"additional option <strong><code>DoNotUse_InitialIntegratorState</code></strong>. This option\r\n"
"is introduced in order that the default initialization for the\r\n"
"<code>Continuous.PID</code> and <code>Continuous.LimPID</code> blocks are backward\r\n"
"compatible. In Modelica 2.2, the integrators have been initialized\r\n"
"with their given states where as the D-part has not been initialized.\r\n"
"The option <strong><code>DoNotUse_InitialIntegratorState</code></strong> leads to this\r\n"
"initialization definition.\r\n"
"</p>\r\n"
"\r\n"
"<p>The following initialization alternatives are available:</p>\r\n"
"<dl>\r\n"
"<dt><code><strong>NoInit</strong></code></dt>\r\n"
"  <dd>No initialization (start values are used as guess values with <code>fixed=false</code>)</dd>\r\n"
"<dt><code><strong>SteadyState</strong></code></dt>\r\n"
"  <dd>Steady state initialization (derivatives of states are zero)</dd>\r\n"
"<dt><code><strong>InitialState</strong></code></dt>\r\n"
"  <dd>Initialization with initial states</dd>\r\n"
"<dt><code><strong>InitialOutput</strong></code></dt>\r\n"
"  <dd>Initialization with initial outputs (and steady state of the states if possible)</dd>\r\n"
"<dt><code><strong>DoNotUse_InitialIntegratorState</strong></code></dt>\r\n"
"  <dd>Do not use, only for backward compatibility (initialize only integrator state)</dd>\r\n"
"</dl>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该初始化类型与 <a href=\"modelica://Modelica.Blocks.Types.Init\" target=\"\">Types.Init</a> 相同，只是多了一个选项<code><strong>DoNotUse_InitialIntegratorState</strong></code>。 引入这个选项是为了使<code>Continuous.PID</code>和<code>Continuous.LimPID</code> 模块的默认初始化向后兼容。 在Modelica2.2中，积分模块已按给定状态初始化， 而D部分尚未初始化。选项<code><strong>DoNotUse_InitialIntegratorState</strong></code> 导致了这种初始化定义。\r\n"
"</p>\r\n"
"<p>\r\n"
"有以下几种初始化方案可供选择：\r\n"
"</p>\r\n"
"<p>\r\n"
"<strong>无初始化</strong>\r\n"
"</p>\r\n"
"<p>\r\n"
"无初始化(在固定值=false时，将起始值用作猜测值)\r\n"
"</p>\r\n"
"<p>\r\n"
"<strong>稳态初始化</strong>\r\n"
"</p>\r\n"
"<p>\r\n"
"稳态初始化(状态导数为零)\r\n"
"</p>\r\n"
"<p>\r\n"
"<strong>初始状态初始化</strong>\r\n"
"</p>\r\n"
"<p>\r\n"
"初始状态初始化\r\n"
"</p>\r\n"
"<p>\r\n"
"<strong>初始输出值初始化</strong>\r\n"
"</p>\r\n"
"<p>\r\n"
"初始输出值初始化(以及可能的稳态初始化)\r\n"
"</p>\r\n"
"<p>\r\n"
"<span style=\"color: rgb(85, 85, 85);\"><strong>不使用初始积分器状态</strong></span>\r\n"
"</p>\r\n"
"<p>\r\n"
"不使用，仅用于向后兼容(仅初始化积分模块状态)\r\n"
"</p>\r\n"
"</html>"

