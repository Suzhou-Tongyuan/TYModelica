"</tr>\r\n"
"<tr>\r\n"
"<td>nominal excitation current</td>\r\n"
"<td>1</td><td>A</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>excitation resistance</td>\r\n"
"<td>100</td><td>Ohm at reference temperature</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>reference temperature TeRef</td>\r\n"
