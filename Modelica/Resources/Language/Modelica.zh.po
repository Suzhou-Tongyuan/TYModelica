msgctxt "Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow"
msgid "Advanced"
msgstr "高级"

msgctxt "Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow"
msgid "Wall friction model"
msgstr "壁面摩擦模型"

msgctxt "Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow"
msgid "Wall friction"
msgstr "壁面摩擦"

msgctxt "Modelica.Fluid.Pipes.BaseClasses.FlowModels.PartialGenericPipeFlow"
