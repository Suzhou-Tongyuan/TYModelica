msgctxt "Modelica.Blocks.Types"
msgid "Linear interpolation of table points"
msgstr "表格点的线性插值"

msgctxt "Modelica.Blocks.Types"
msgid "Akima spline interpolation of table points (such that the first derivative is continuous)"
msgstr "表格数据点的Akima样条插值(确保一阶导数连续)"

msgctxt "Modelica.Blocks.Types"
msgid "Piecewise constant interpolation of table points (the value from the previous abscissa point is returned)"
msgstr "分段常数插值(返回上一个轴值点的值)"

msgctxt "Modelica.Blocks.Types"
msgid "Fritsch-Butland spline interpolation (such that the monotonicity is preserved and the first derivative is continuous)"
msgstr "Fritsch-Butland样条插值(确保单调性且一阶导数连续)"

msgctxt "Modelica.Blocks.Types"
msgid "Steffen spline interpolation of table points (such that the monotonicity is preserved and the first derivative is continuous)"
msgstr "Steffen样条插值表数据点(确保单调性且一阶导数连续)"

