msgstr "%name"

msgctxt "Modelica.Magnetic.FluxTubes.Sources.ConstantMagneticFlux"
msgid "<html>\r\n"
"<p>\r\n"
"Sources of a constant magnetic flux are useful for modelling of permanent magnets with <em>Norton</em>'s magnetic equivalent circuit.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"恒定磁通的来源对于用Norton</em>磁等效电路模拟永磁体是有用的.\r\n"
"</p>\r\n"
"</html>"

