msgctxt "Modelica.Math.BooleanVectors.countTrue"
msgid "Returns the number of true elements in a Boolean vector"
msgstr "返回布尔向量中为真的元素个数"

msgctxt "Modelica.Math.BooleanVectors.countTrue"
msgid "Boolean vector"
msgstr "布尔向量"

msgctxt "Modelica.Math.BooleanVectors.countTrue"
msgid "Number of true elements in b"
msgstr "b中真元素的个数"

msgctxt "Modelica.Math.BooleanVectors.countTrue"
msgid "<html>\r\n"
"<h4>Syntax</h4>\r\n"
"<blockquote><pre>\r\n"
"<strong>countTrue</strong>(b);\r\n"
