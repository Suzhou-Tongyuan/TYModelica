msgctxt "Modelica.Magnetic.QuasiStatic.FundamentalWave.Components.EddyCurrent"
msgid "Equivalent symmetric loss conductance"
msgstr "等效对称损耗电导"

msgctxt "Modelica.Magnetic.QuasiStatic.FundamentalWave.Components.EddyCurrent"
msgid "Angular velocity"
msgstr "角速度"

msgctxt "Modelica.Magnetic.QuasiStatic.FundamentalWave.Components.EddyCurrent"
