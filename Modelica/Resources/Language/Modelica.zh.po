"<li><em>Nov. 3, 1999</em>\r\n"
"by <a href=\"http://www.robotic.dlr.de/Martin.Otter/\">Martin Otter</a>:<br>\r\n"
"Vectorized and moved from Rotational to Blocks.Sources.</li>\r\n"
"<li><em>June 29, 1999</em>\r\n"
"by <a href=\"http://www.robotic.dlr.de/Martin.Otter/\">Martin Otter</a>:<br>\r\n"
"realized.</li>\r\n"
"</ul>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Sources.KinematicPTP2"
msgid "Move as fast as possible from start to end position within given kinematic constraints with output signals q, qd=der(q), qdd=der(qd)"
msgstr "在给定的运动学约束条件下，尽可能快地从起点位置移动到终点位置，输出信号q、qd=der(q)、qdd=der(qd)"

