msgstr "横坐标值"

msgctxt "Modelica.Fluid.Utilities.regStep"
msgid "Ordinate value for x > 0"
msgstr "x > 0 时的纵坐标值"

msgctxt "Modelica.Fluid.Utilities.regStep"
