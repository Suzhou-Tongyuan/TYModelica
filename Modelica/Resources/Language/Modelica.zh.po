msgctxt "Modelica.Electrical.Digital.Delay.TransportDelay"
msgid "%name"
msgstr "%name"

msgctxt "Modelica.Electrical.Digital.Delay.TransportDelay"
msgid "Transport"
msgstr "传输"

msgctxt "Modelica.Electrical.Digital.Delay.TransportDelay"
msgid "Delay"
msgstr "延迟"

msgctxt "Modelica.Electrical.Digital.Delay.InertialDelay"
msgid "Inertial delay with initial parameter"
msgstr "具有初始参数的惯性延迟"

msgctxt "Modelica.Electrical.Digital.Delay.InertialDelay"
msgid "Minimum time to hold value"
msgstr "保持值的最小时间"

msgctxt "Modelica.Electrical.Digital.Delay.InertialDelay"
msgid "Initial value of output y"
msgstr "输出y的初始值"

msgctxt "Modelica.Electrical.Digital.Delay.InertialDelay"
msgid "<html>\r\n"
"<p>\r\n"
"Provides the input as output delayed by <em>delayTime</em> if the input holds its value for a longer time than <em>delayTime</em>.\r\n"
"If time is less than <em>delayTime</em> the initial value <em>y0</em> holds.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"如果输入保持其值的时间超过<em>delayTime</em>，则提供输入作为延迟了<em>delayTime</em>的输出。\r\n"
"如果时间小于<em>delayTime</em>，则保持初始值<em>y0</em>。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.Digital.Delay.InertialDelay"
msgid "<html>\r\n"
"<dl>\r\n"
"<dt><em>August 12, 2003</em></dt>\r\n"
"<dd>by Christoph Clauss revised</dd>\r\n"
"<dt><em>March 19, 2003</em></dt>\r\n"
"<dd>by Martin Otter initially modelled.</dd>\r\n"
"</dl>\r\n"
"</html>"
msgstr "<html>\r\n"
"<dl>\r\n"
"<dt><em>2003年8月12日</em></dt>\r\n"
"<dd>由Christoph Clauss修订</dd>\r\n"
"<dt><em>2003年3月19日</em></dt>\r\n"
"<dd>由Martin Otter最初建模。</dd>\r\n"
