"</tr>\r\n"
"<tr>\r\n"
"<td>额定励磁电压</td>\r\n"
"<td>100</td><td>V</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>额定励磁电流</td>\r\n"
"<td>1</td><td>A</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>励磁电阻</td>\r\n"
"<td>100</td><td>参考温度下的欧姆</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>参考温度TeRef</td>\r\n"
"<td>20</td><td>°C</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>温度系数alpha20e </td>\r\n"
"<td>0</td><td>1/K</td>\r\n"
