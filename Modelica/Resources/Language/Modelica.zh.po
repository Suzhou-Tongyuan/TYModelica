msgctxt "Modelica.Electrical.Spice3.Basic.K_CoupledInductors"
msgid "Inductive coupling via coupling factor"
msgstr "通过耦合系数的感应耦合"

msgctxt "Modelica.Electrical.Spice3.Basic.K_CoupledInductors"
msgid "Coupling factor"
msgstr "耦合系数"

msgctxt "Modelica.Electrical.Spice3.Basic.K_CoupledInductors"
msgid "Couple pin for inductances"
msgstr "感应耦合的耦合引脚"

msgctxt "Modelica.Electrical.Spice3.Basic.K_CoupledInductors"
msgid "Mutual inductance"
msgstr "互感"

