msgstr "理想传感器，用于测量绝对一维转动接口角度"

msgctxt "Modelica.Mechanics.Rotational.Sensors.AngleSensor"
msgid "Absolute angle of flange as output signal"
msgstr "作为输出信号的一维转动接口绝对角度"

msgctxt "Modelica.Mechanics.Rotational.Sensors.AngleSensor"
msgid "<html>\r\n"
