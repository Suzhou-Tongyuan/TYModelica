msgctxt "Modelica.Math.BooleanVectors.andTrue"
msgid "Returns true, if all elements of the Boolean input vector are true ('and')"
msgstr "如果布尔输入向量的所有元素都为真('与')，则返回true"

msgctxt "Modelica.Math.BooleanVectors.andTrue"
msgid "Boolean vector"
msgstr "布尔向量"

msgctxt "Modelica.Math.BooleanVectors.andTrue"
msgid "= true, if all elements of b are true"
msgstr "= true，如果b的所有元素都为真"

msgctxt "Modelica.Math.BooleanVectors.andTrue"
msgid "<html>\r\n"
