msgstr "约简密度 (delta=d/dcrit)"

msgctxt "Modelica.Media.R134a.R134a_ph.fres_R134a"
msgid "Reduced temperature (tau=Tcrit/T)"
msgstr "约简温度 (tau=Tcrit/T)"

msgctxt "Modelica.Media.R134a.R134a_ph.fres_R134a"
