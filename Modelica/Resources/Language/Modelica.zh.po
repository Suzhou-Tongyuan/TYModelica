"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/cosh.png\"\r\n"
"     alt=\"cosh.png\">\r\n"
"</div>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong>计算为 输入<strong>u</strong>的<em>双曲余弦值</em>：\r\n"
"</p>\r\n"
"<pre><code >y = Cosh( u );\r\n"
"</pre>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/Cosh.png\" alt=\"sinh.png\" data-href=\"\" style=\"\"/></code><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Tanh"
msgid "Output the hyperbolic tangent of the input"
msgstr "输出输入值的双曲正切值"

msgctxt "Modelica.Blocks.Math.Tanh"
msgid "tanh"
msgstr "tanh"

msgctxt "Modelica.Blocks.Math.Tanh"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong> as the\r\n"
"<em>hyperbolic tangent</em> of the input <strong>u</strong>:\r\n"
