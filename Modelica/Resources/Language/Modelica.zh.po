msgctxt "Modelica.Thermal.FluidHeatFlow.Interfaces"
msgid "Connectors and partial models"
msgstr "连接器和基类模型"

msgctxt "Modelica.Thermal.FluidHeatFlow.Interfaces"
msgid "<html>\r\n"
"<p>This package contains connectors and partial models:</p>\r\n"
"<ul>\r\n"
"<li>FlowPort: basic definition of the connector.</li>\r\n"
"<li>FlowPort_a &amp; FlowPort_b: same as FlowPort with different icons to differentiate direction of flow</li>\r\n"
"</ul>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该子库包含连接器和基类模型：\r\n"
"</p>\r\n"
"<li>\r\n"
"FlowPort: 连接器的基本定义。</li>\r\n"
"<li>\r\n"
"FlowPort_a & FlowPort_b: 与 FlowPort 相同，用不同的图标区分流向。</li>\r\n"
"</html>"

