msgctxt "Modelica.Mechanics.MultiBody.Joints.Assemblies.JointUPS"
msgid "Vector in direction of second rotation axis of universal joint, resolved in frame_a"
msgstr "通用运动副第二旋转轴方向的矢量，在frame_a中解析"

