"       </tr>\r\n"
"       <tr>\r\n"
"       <td>&nbsp;7<br>\r\n"
"      </td>\r\n"
"      <td>Specific internal energy<br>\r\n"
"       </td>\r\n"
"       <td>u<br>\r\n"
"       </td>\r\n"
"       <td>J/kg<br>\r\n"
"       </td>\r\n"
"       </tr>\r\n"
"       <tr>\r\n"
"       <td>&nbsp;8<br>\r\n"
"      </td>\r\n"
"      <td>Specific isobaric heat capacity</td>\r\n"
"       <td>c<sub>p</sub><br>\r\n"
"       </td>\r\n"
"       <td>J/(kg K)<br>\r\n"
"       </td>\r\n"
"       </tr>\r\n"
"       <tr>\r\n"
"       <td>&nbsp;9<br>\r\n"
"      </td>\r\n"
"      <td>Specific isochoric heat capacity</td>\r\n"
"       <td>c<sub>v</sub><br>\r\n"
"       </td>\r\n"
"       <td>J/(kg K)<br>\r\n"
"       </td>\r\n"
"       </tr>\r\n"
"       <tr>\r\n"
"       <td>10<br>\r\n"
"      </td>\r\n"
"      <td>Isentropic exponent, kappa = -(v/p) (dp/dv)<sub>s</sub></td>\r\n"
"     <td>kappa (&kappa;)<br>\r\n"
"     </td>\r\n"
