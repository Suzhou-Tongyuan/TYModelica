msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Base model for valves"
msgstr "阀门的基本模型"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Selection of flow coefficient"
msgstr "选择流量系数"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Flow coefficient"
msgstr "流量系数"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Av (metric) flow coefficient"
msgstr "（公制）流量系数 Av"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
