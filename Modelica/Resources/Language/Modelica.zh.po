"<td><img src=\"modelica://Modelica/Resources/Images/UsersGuide/Conventions/Icons/colorSampleElectricalSpice3.png\"></td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>Modelica.Magnetic.FluxTubes</td>\r\n"
