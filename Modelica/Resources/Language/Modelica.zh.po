msgstr "表面坐标系"

msgctxt "Modelica.Mechanics.MultiBody.Visualizers.Advanced.PipeWithScalarField"
msgid "Position vector from origin of world frame to origin of surface frame, resolved in world frame"
msgstr "从全局坐标系原点到表面坐标系原点的位置矢量，以全局坐标系解析"

msgctxt "Modelica.Mechanics.MultiBody.Visualizers.Advanced.PipeWithScalarField"
