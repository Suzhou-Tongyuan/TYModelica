"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/tanh.png\"\r\n"
"   alt=\"tanh.png\">\r\n"
"</div>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Exp"
msgid "Output the exponential (base e) of the input"
msgstr "输出输入的指数函数(以e为底)"

msgctxt "Modelica.Blocks.Math.Exp"
msgid "exp"
msgstr "exp"

msgctxt "Modelica.Blocks.Math.Exp"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong> as the\r\n"
"<em>exponential</em> (of base e) of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>exp</strong>( u );\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/exp.png\"\r\n"
"     alt=\"exp.png\">\r\n"
"</div>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong> 计算为输入<strong>u</strong>的<em>指数</em>（基数为e）：\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>exp</strong>( u );\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/exp.png\"\r\n"
"   alt=\"exp.png\">\r\n"
"</div>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Power"
msgid "Output the power to a base of the input"
msgstr "输出输入的指数函数(以e为底)"

msgctxt "Modelica.Blocks.Math.Power"
msgid "Base of power"
msgstr "幂的底数"

msgctxt "Modelica.Blocks.Math.Power"
msgid "Use exp function in implementation"
msgstr "在执行中使用exp函数"

msgctxt "Modelica.Blocks.Math.Power"
msgid "^"
msgstr "^"

msgctxt "Modelica.Blocks.Math.Power"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong> as the\r\n"
"power to the parameter <em>base</em> of the input <strong>u</strong>.\r\n"
"If the boolean parameter <strong>useExp</strong> is true, the output is determined by:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>exp</strong> ( u * <strong>log</strong> (base) )\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"otherwise:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = base <strong>^</strong> u;\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong>计算为输入<strong>u</strong>以参数<em>base</em>为底的幂次方。 如果布尔参数<strong>useExp</strong>为真，则输出由以下方式决定：\r\n"
"</p>\r\n"
"<pre><code >y = exp ( u * log (base) )</code></pre><p>\r\n"
"否则:\r\n"
"</p>\r\n"
"<pre><code >y = base ^ u;</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Pow"
msgid "Power function block"
msgstr "幂函数模块"

msgctxt "Modelica.Blocks.Math.Pow"
msgid "Use Input exponent"
msgstr "是否使用外接输入指数"

msgctxt "Modelica.Blocks.Math.Pow"
msgid "Exponent"
msgstr "指数"

msgctxt "Modelica.Blocks.Math.Pow"
msgid "Input exponent"
msgstr "输入指数"

msgctxt "Modelica.Blocks.Math.Pow"
msgid "^"
msgstr "^"

msgctxt "Modelica.Blocks.Math.Pow"
msgid "<html><p>\r\n"
"This blocks is a power function, the base is the independent variable u, the power is the dependent variable y, and the exponent is base:\r\n"
"</p>\r\n"
"<pre><code >y = u ^ base;\r\n"
"</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块为幂函数，底数为自变量u，幂为因变量y，指数为base\r\n"
"</p>\r\n"
"<pre><code >y = u ^ base;\r\n"
"</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Log"
msgid "Output the logarithm (default base e) of the input (input > 0 required)"
msgstr "输出输入值的对数(默认以e为底)(要求输入值>0)"

msgctxt "Modelica.Blocks.Math.Log"
msgid "Base of logarithm"
msgstr "对数底数"

msgctxt "Modelica.Blocks.Math.Log"
msgid "log"
msgstr "log"

msgctxt "Modelica.Blocks.Math.Log"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong> as the\r\n"
"<em>logarithm</em> to the parameter <em>base</em> of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>log</strong>( u ) / <strong>log</strong>( base );\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"An error occurs if the input <strong>u</strong> is\r\n"
"zero or negative.\r\n"
"</p>\r\n"
"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Math/log.png\"\r\n"
"     alt=\"log.png\">\r\n"
"</div>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong>计算为 输入<strong>u</strong>以e为底的<em>对数</em>：\r\n"
"</p>\r\n"
"<pre><code >y = log( u ) / log( base );</code></pre><p>\r\n"
"如果输入<strong>u</strong>为零或负值，则会出现错误。\r\n"
"</p>\r\n"
"<p style=\"text-align: center;\"><img src=\"modelica://Modelica/Resources/Images/Math/log.png\" alt=\"log.png\" data-href=\"\" style=\"\">\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Log10"
