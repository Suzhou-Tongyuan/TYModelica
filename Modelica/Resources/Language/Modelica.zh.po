"\r\n"
"<tr><td colspan=\"2\"><strong>Mechanics.MultiBody.Joints.Internal</strong></td></tr>\r\n"
"<tr><td> RevoluteWithLengthConstraint<br>\r\n"
"                                                PrismaticWithLengthConstraint</td>\r\n"
"          <td> 这些接头不应该被MultiBody库的用户使用。\r\n"
