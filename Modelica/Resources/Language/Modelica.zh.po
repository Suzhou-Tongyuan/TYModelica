msgstr "转动副（圆柱体）的长度"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Universal"
msgid "Animation"
msgstr "动画"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Universal"
