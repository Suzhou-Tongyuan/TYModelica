msgid "Coefficients of polynomial"
msgstr "多项式的系数"

msgctxt "Modelica.Electrical.Spice3.Additionals.F_CCC_POLY"
msgid "Positive pin of the right port (potential p2.v > n2.v for positive voltage drop v2)"
msgstr "右侧端口的正极(对于正电压降v2，p2.v>n2.v)"

