msgctxt "Modelica.Magnetic.FluxTubes.Shapes.FixedShape.HollowCylinderRadialFlux"
msgid "Width (orthogonal to flux direction)"
msgstr "宽度（与通量方向正交）"

msgctxt "Modelica.Magnetic.FluxTubes.Shapes.FixedShape.HollowCylinderRadialFlux"
