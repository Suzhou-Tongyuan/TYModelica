msgstr "实数极点状态下的奇数阶，否则为空值"

msgctxt "Modelica.Blocks.Continuous.LowpassButterworth"
msgid "LowpassButterworthFilter"
msgstr "LowpassButterworthFilter"

msgctxt "Modelica.Blocks.Continuous.LowpassButterworth"
