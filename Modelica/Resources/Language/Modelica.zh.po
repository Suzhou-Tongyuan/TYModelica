msgid "With neutral, inverse component"
msgstr "带中性反向分量"

msgctxt "Modelica.Electrical.QuasiStatic.Polyphase.Examples.UnsymmetricalLoad"
msgid "With neutral, zero component"
msgstr "带中性零分量"

