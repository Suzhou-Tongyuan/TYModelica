msgstr "信息标志(0:FFT计算，1:nu不是偶数，2:网络错误，3:另一个错误)"

msgctxt "Modelica.Math.FastFourierTransform.Internal.rawRealFFT"
msgid "Amplitudes of FFT"
msgstr "FFT的振幅"

msgctxt "Modelica.Math.FastFourierTransform.Internal.rawRealFFT"
