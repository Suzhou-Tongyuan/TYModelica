msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "Positive pin to shunt excitation"
msgstr "分接励磁的正极引脚"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "Negative pin to shunt excitation"
msgstr "分接励磁的负极引脚"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "Positive pin to series excitation"
msgstr "级联励磁的正极引脚"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "Negative pin to series excitation"
msgstr "级联励磁的负极引脚"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "S"
msgstr "S"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "E"
msgstr "E"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.CompoundDCExcitation"
msgid "<html>\r\n"
"Model to compound the shunt excitation current and the series excitation current to the total excitation current w.r.t. shunt excitation.\r\n"
"This model is intended to be placed between shunt and series excitation pins and the airgap;\r\n"
"the connection to airgap has to be grounded at one point.\r\n"
"</html>"
msgstr "<html>\r\n"
"模型将分接励磁电流和级联励磁电流复合成总的励磁电流相对于分接励磁。\r\n"
"此模型旨在放置在分接和级联励磁引脚和空气间之间；\r\n"
"空气间的连接必须在一个点接地。\r\n"
"</html>"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.PartialCore"
