msgid "Advanced"
msgstr "高级"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Assemblies.JointSSR"
msgid "Denominator used to compute force in rod connecting universal and spherical joint"
msgstr "用于计算连接万向节和球面副的杆的力的分母"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Assemblies.JointSSR"
msgid "Constraint force in direction of the rod (positive, if rod is pressed)"
msgstr "杆沿杆方向的约束力(如果杆被按压，则为正)"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Assemblies.JointSSR"
