msgctxt "Modelica.Electrical.PowerConverters.Examples"
msgid "Examples"
msgstr "示例"

msgctxt "Modelica.Electrical.PowerConverters.Examples"
msgid "<html>\r\n"
"<p>This is a collection of AC/DC, DC/DC and DC/AC converters.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>这是一组AC/DC、DC/DC和DC/AC转换器示例。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC"
msgid "AC to DC converter examples"
msgstr "AC到DC转换器示例"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse"
msgid "Single pulse rectifier"
msgstr "单脉冲整流器"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse"
msgid "<html>\r\n"
"<p>This package includes examples of single pulse controlled rectifiers.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>该包包含单脉冲控制整流器的示例。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R"
msgid "One pulse rectifier with resistive load and constant firing angle"
msgstr "具有电阻负载和恒定触发角的单脉冲整流器"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R"
msgid "Firing angle"
msgstr "触发角"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R"
msgid "Load resistance"
msgstr "负载电阻"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R"
msgid "<html>\r\n"
"<p>This example demonstrates the operational behavior of a single-phase controlled rectifier with constant firing angle and resistive load.</p>\r\n"
"<p>Plot current <code>currentSensor.i</code>, average current <code>meanCurrent.y</code>, voltage <code>voltageSensor.v</code> and average voltage <code>meanVoltage.v</code>.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>该示例演示了具有恒定触发角和电阻负载的单相控制整流器的运行行为。</p>\r\n"
"<p>绘制电流<code>currentSensor.i</code>、平均电流<code>meanCurrent.y</code>、电压<code>voltageSensor.v</code>和平均电压<code>meanVoltage.v</code>。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R_Characteristic"
msgid "Control characteristic of one pulse rectifier with resistive load"
msgstr "具有电阻负载的单脉冲整流器的控制特性"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R_Characteristic"
msgid "Load resistance"
msgstr "负载电阻"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.Rectifier1Pulse.Thyristor1Pulse_R_Characteristic"
msgid "<html>\r\n"
"<p>This example demonstrates the operational behavior of a single-phase controlled rectifier with variable firing angle and resistive load. The average load voltage can be controlled by means of the firing angle.</p>\r\n"
"<p><br>Plot average voltage <code>meanVoltage.v</code> versus firingAngle <code>pulse2.firingAngle</code> to see control characteristic of this type of rectifier with resistive load.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>该示例演示了具有可变触发角和电阻负载的单相控制整流器的运行行为。通过触发角可以控制平均负载电压。</p>\r\n"
"<p><br>绘制平均电压<code>meanVoltage.v</code>与触发角<code>pulse2.firingAngle</code>的关系图，以查看具有电阻负载的这种类型整流器的控制特性。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse"
msgid "Two pulse Graetz bridge"
msgstr "双脉冲格雷茨桥"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse"
msgid "<html>\r\n"
"<p>This package includes single-phase two pulse bridge rectifiers. The examples show uncontrolled and controlled rectifiers with constant and variable firing angle.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>该包括单相两脉冲桥式整流器。示例展示了具有恒定和可变触发角的无控制和受控整流器。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.DiodeBridge2Pulse"
msgid "Two pulse Graetz diode bridge with resistive load"
msgstr "具有电阻负载的双脉冲格雷茨二极管桥"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.DiodeBridge2Pulse"
msgid "RMS supply voltage"
msgstr "有效值供电电压"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.DiodeBridge2Pulse"
msgid "Frequency"
msgstr "频率"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.DiodeBridge2Pulse"
msgid "Load resistance"
msgstr "负载电阻"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.DiodeBridge2Pulse"
msgid "<html>\r\n"
"<p>This examples shows a two pulse uncontrolled bridge example with resistive load.</p>\r\n"
"\r\n"
"<p>Plot current <code>currentSensor.i</code>, average current <code>meanCurrent.y</code>, voltage <code>voltageSensor.v</code> and average voltage <code>meanVoltage.v</code>.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>这个示例展示了具有电阻负载的双脉冲未控制桥整流器。</p>\r\n"
"\r\n"
"<p>绘制电流 <code>currentSensor.i</code>、平均电流 <code>meanCurrent.y</code>、电压 <code>voltageSensor.v</code> 和平均电压 <code>meanVoltage.v</code>。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse"
msgid "Two pulse Graetz half controlled bridge with resistive load"
msgstr "具有电阻负载的双脉冲半控制桥整流器"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse"
msgid "RMS supply voltage"
msgstr "有效值供电电压"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse"
msgid "Frequency"
msgstr "频率"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse"
msgid "Firing angle"
msgstr "导通角"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse"
msgid "Load resistance"
msgstr "负载电阻"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse"
msgid "<html>\r\n"
"<p>This examples shows a two pulse half controlled bridge example with resistive load. In case of resistive load the half controlled bridge shows the same output voltage as the\r\n"
"<a href=\"modelica://Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_R\">full controlled bridge</a>.</p>\r\n"
"\r\n"
"<p>Plot current <code>currentSensor.i</code>, average current <code>meanCurrent.y</code>, voltage <code>voltageSensor.v</code> and average voltage <code>meanVoltage.v</code>.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>这个示例展示了具有电阻负载的双脉冲半控制桥整流器。在电阻负载的情况下，半控制桥显示与完全控制桥相同的输出电压。</p>\r\n"
"\r\n"
"<p>绘制电流 <code>currentSensor.i</code>、平均电流 <code>meanCurrent.y</code>、电压 <code>voltageSensor.v</code> 和平均电压 <code>meanVoltage.v</code>。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_R"
msgid "Two pulse Graetz thyristor bridge rectifier with resistive load"
msgstr "具有电阻负载的双脉冲格雷兹晶闸管桥整流器"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_R"
msgid "Firing angle"
msgstr "导通角"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_R"
msgid "Load resistance"
msgstr "负载电阻"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_R"
msgid "<html>\r\n"
"<p>This examples shows a two pulse full controlled bridge example with resistive load. In case of resistive load the full controlled bridge shows the same output voltage as the\r\n"
"<a href=\"modelica://Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse\">half controlled bridge</a>.</p>\r\n"
"\r\n"
"<p>Plot current <code>currentSensor.i</code>, average current <code>meanCurrent.y</code>, voltage <code>voltageSensor.v</code> and average voltage <code>meanVoltage.v</code>.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>这个示例展示了一个具有电阻负载的双脉冲全控制桥整流器。在电阻负载的情况下，全控制桥显示与半控制桥<a href=\"modelica://Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.HalfControlledBridge2Pulse\">相同的输出电压</a>。</p>\r\n"
"\r\n"
"<p>绘制电流 <code>currentSensor.i</code>、平均电流 <code>meanCurrent.y</code>、电压 <code>voltageSensor.v</code> 和平均电压 <code>meanVoltage.v</code>。</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_RL"
msgid "Two pulse Graetz thyristor bridge rectifier with R-L load"
msgstr "具有电阻电感负载的双脉冲格雷兹晶闸管桥整流器"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_RL"
msgid "Firing angle"
msgstr "导通角"

msgctxt "Modelica.Electrical.PowerConverters.Examples.ACDC.RectifierBridge2Pulse.ThyristorBridge2Pulse_RL"
msgid "Load resistance"
