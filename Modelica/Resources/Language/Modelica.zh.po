msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToReal"
msgid "Converts complex to Cartesian representation"
msgstr "将复数转换为笛卡尔表示法"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToReal"
msgid "If true, input is processed conjugate complex"
msgstr "如果为真，则处理输入的共轭复数"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToReal"
msgid "re"
msgstr "re"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToReal"
msgid "im"
msgstr "im"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToReal"
msgid "C"
msgstr "C"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToReal"
msgid "<html>\r\n"
"<p>Converts the Complex input <em>u</em> to the Real outputs <em>re</em> (real part) and <em>im</em> (imaginary part).</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>将复数输入 <em>u</em> 转换为实部 <em>re</em> 和虚部 <em>im</em> 的实数输出。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToPolar"
msgid "Converts complex to polar representation"
msgstr "复数转换为极坐标表示"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToPolar"
msgid "If true, input is processed conjugate complex"
msgstr "如果为真，则处理输入的共轭复数"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToPolar"
msgid "len"
msgstr "len"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToPolar"
msgid "phi"
msgstr "phi"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToPolar"
msgid "C"
msgstr "C"

msgctxt "Modelica.ComplexBlocks.ComplexMath.ComplexToPolar"
msgid "<html>\r\n"
"<p>Converts the Complex input <em>u</em> to the Real outputs <em>len</em> (length, absolute) and <em>phi</em> (angle, argument).</p>\r\n"
