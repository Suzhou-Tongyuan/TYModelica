msgstr "与 D 有关的恒压损失系数 (port_a 或 port_b)"

msgctxt "Modelica.Fluid.Fittings.BaseClasses.lossConstant_D_zeta"
msgid "Loss constant (= 8*zeta/(pi^2*D^4))"
msgstr "损失常数 (= 8*zeta/(pi^2*D^4))"

msgctxt "Modelica.Fluid.Fittings.BaseClasses.lossConstant_D_zeta"
msgid "<html>\r\n"
"\r\n"
"</html>"
msgstr "<html>\r\n"
"\r\n"
