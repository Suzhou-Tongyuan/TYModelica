msgctxt "Modelica.Blocks.Math.Abs"
msgid "Output the absolute value of the input"
msgstr "输出输入值的绝对值"

msgctxt "Modelica.Blocks.Math.Abs"
msgid "Choose whether events shall be generated"
msgstr "选择是否生成事件"

msgctxt "Modelica.Blocks.Math.Abs"
msgid "abs"
msgstr "abs"

msgctxt "Modelica.Blocks.Math.Abs"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong>\r\n"
"as <em>absolute value</em> of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>abs</strong>( u );\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"The Boolean parameter generateEvent decides whether Events are generated at zero crossing (Modelica specification before 3) or not.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong>计算为 输入<strong>u</strong>的 <em>绝对值</em>：\r\n"
"</p>\r\n"
"<pre><code >y = abs( u );</code></pre><p>\r\n"
"布尔型参数 generateEvent 决定事件是否在过零点时生成（Modelica 规范 3 之前）。\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Sign"
msgid "Output the sign of the input"
msgstr "输出输入信号的符号"

msgctxt "Modelica.Blocks.Math.Sign"
msgid "Choose whether events shall be generated"
msgstr "选择是否生成事件"

msgctxt "Modelica.Blocks.Math.Sign"
msgid "sign"
msgstr "sign"

msgctxt "Modelica.Blocks.Math.Sign"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong>\r\n"
"as <strong>sign</strong> of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"     1  <strong>if</strong> u &gt; 0\r\n"
"y =  0  <strong>if</strong> u == 0\r\n"
"    -1  <strong>if</strong> u &lt; 0\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"The Boolean parameter generateEvent decides whether Events are generated at zero crossing (Modelica specification before 3) or not.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong> 计算为输入<strong>u</strong>的<strong>sign</strong>：\r\n"
"</p>\r\n"
"<pre><code >1  if u &gt; 0\r\n"
"y =  0  if u == 0\r\n"
"-1  if u &lt; 0</code></pre><p>\r\n"
"布尔型参数 generateEvent 决定事件是否在过零点时生成（Modelica 规范 3 之前）。\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.Sqrt"
msgid "Output the square root of the input (input >= 0 required)"
msgstr "输出输入值的平方根(要求输入值>=0)"

msgctxt "Modelica.Blocks.Math.Sqrt"
msgid "sqrt"
msgstr "sqrt"

msgctxt "Modelica.Blocks.Math.Sqrt"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong>\r\n"
"as <em>square root</em> of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>sqrt</strong>( u );\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"The input shall be zero or positive.\r\n"
"Otherwise an error occurs.\r\n"
"</p>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong> 计算为输入<strong>u</strong>的<em>平方根</em>：\r\n"
"</p>\r\n"
"<pre><code >y = sqrt( u );</code></pre><p>\r\n"
"输入值必须为零或正。 否则会出错。\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

