msgctxt "Modelica.Fluid.Dissipation.Utilities.Functions.General.LambertW"
msgid "Closed approximation of Lambert's w function for solving f(x) = x exp(x) for x"
msgstr "求解 f(x) = x exp(x) 的 Lambert w 函数的封闭近似"

