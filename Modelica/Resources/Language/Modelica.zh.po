msgctxt "Modelica.Math.Distributions.Uniform.density"
msgid "Density of uniform distribution"
msgstr "均匀分布密度"

msgctxt "Modelica.Math.Distributions.Uniform.density"
msgid "Lower limit of u"
msgstr "u的下限"

msgctxt "Modelica.Math.Distributions.Uniform.density"
