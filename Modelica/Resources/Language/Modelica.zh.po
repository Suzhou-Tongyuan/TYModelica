msgctxt "Modelica.Blocks.Math.Cot"
msgid "Output the cotangent of the input"
msgstr "输出输入值的余切值"

msgctxt "Modelica.Blocks.Math.Cot"
msgid "cot"
msgstr "cot"

msgctxt "Modelica.Blocks.Math.Cot"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes the output <strong>y</strong>\r\n"
"as <strong>cot</strong> of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>cot</strong>( u );\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"if u is a multiple of pi, y = cot(u) is +/- infinity).\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该模块将输出<strong>y</strong>，计算为输入<strong>u</strong>的<strong>cot</strong>：\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
