msgctxt "Modelica.Electrical.Polyphase.Basic.ZeroInductor"
msgid "<html>\r\n"
"<p>\r\n"
"Model of a polyphase zero sequence inductor.\r\n"
"</p>\r\n"
"<h4>Implementation</h4>\r\n"
"<blockquote><pre>\r\n"
"v = Lzero*sum(der(i)) = Lzero*der(sum(i))\r\n"
"</pre></blockquote>\r\n"
"\r\n"
