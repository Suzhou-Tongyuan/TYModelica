msgstr "（US） 流量系数 Cv [USG/min]"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Nominal pressure drop"
msgstr "额定压降"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Nominal operating point"
msgstr "额定工作点"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Nominal mass flowrate"
msgstr "额定质量流量"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "Nominal inlet density"
msgstr "额定入口密度"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
