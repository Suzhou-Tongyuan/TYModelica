msgctxt "Modelica.Blocks.Discrete.TriggeredSampler"
msgid "Triggered sampling of continuous signals"
msgstr "连续信号的触发式采样"

msgctxt "Modelica.Blocks.Discrete.TriggeredSampler"
msgid "Initial value of output signal"
msgstr "输出信号的初始值"

msgctxt "Modelica.Blocks.Discrete.TriggeredSampler"
msgid "Connector with a Real input signal"
msgstr "带实数输入信号的连接器"

msgctxt "Modelica.Blocks.Discrete.TriggeredSampler"
msgid "Connector with a Real output signal"
msgstr "带实数输出信号的连接器"

msgctxt "Modelica.Blocks.Discrete.TriggeredSampler"
msgid "Trigger input"
msgstr "触发输入"

msgctxt "Modelica.Blocks.Discrete.TriggeredSampler"
msgid "<html>\r\n"
"<p>\r\n"
"Samples the continuous input signal whenever the trigger input\r\n"
"signal is rising (i.e., trigger changes from <strong>false</strong> to\r\n"
"<strong>true</strong>) and provides the sampled input signal as output.\r\n"
"Before the first sampling, the output signal is equal to\r\n"
"the initial value defined via parameter <strong>y0</strong>.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"每当触发输入信号上升(即触发由<strong>false</strong>变<strong>true</strong>)时，\r\n"
"对连续输入信号进行采样，\r\n"
"并将采样后的输入信号作为输出。\r\n"
"在第一次采样之前，\r\n"
"输出信号等于参数<strong>y0</strong>定义的初始值。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Discrete.TriggeredMax"
msgid "Compute maximum, absolute value of continuous signal at trigger instants"
msgstr "计算触发时刻连续信号的最大绝对值"

msgctxt "Modelica.Blocks.Discrete.TriggeredMax"
msgid "Connector with a Real input signal"
msgstr "带实数输入信号的连接器"

msgctxt "Modelica.Blocks.Discrete.TriggeredMax"
msgid "Connector with a Real output signal"
msgstr "带实数输出信号的连接器"

msgctxt "Modelica.Blocks.Discrete.TriggeredMax"
msgid "max"
msgstr "max"

msgctxt "Modelica.Blocks.Discrete.TriggeredMax"
msgid "<html>\r\n"
"<p>\r\n"
"Samples the continuous input signal whenever the trigger input\r\n"
"signal is rising (i.e., trigger changes from <strong>false</strong> to\r\n"
"<strong>true</strong>). The maximum, absolute value of the input signal\r\n"
"at the sampling point is provided as output signal.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"每当触发输入信号上升\r\n"
"(即触发由<strong>false</strong>变<strong>true</strong>)时，\r\n"
"对连续输入信号进行采样。\r\n"
"采样点输入信号的最大绝对值将作为输出信号提供。\r\n"
"</p>\r\n"
"</html>"

