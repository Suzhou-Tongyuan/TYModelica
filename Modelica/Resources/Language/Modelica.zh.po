msgstr "转动副（圆柱体）的直径"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Universal"
msgid "Color of cylinders representing the joint axes"
msgstr "转动副（圆柱体）的颜色"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Universal"
msgid "Reflection of ambient light (= 0: light is completely absorbed)"
msgstr "环境光的反射(=0：光完全被吸收)"

