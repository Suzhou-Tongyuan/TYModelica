msgctxt "Modelica.Blocks.Math.Add3"
msgid "Connector of Boolean input signal 1"
msgstr "布尔型输入信号1接口"

msgctxt "Modelica.Blocks.Math.Add3"
msgid "Connector of Boolean input signal 2"
msgstr "布尔型输入信号2接口"

msgctxt "Modelica.Blocks.Math.Add3"
msgid "Connector of Boolean input signal 3"
msgstr "布尔型输入信号3接口"

msgctxt "Modelica.Blocks.Math.Add3"
msgid "Connector of Real output signal"
msgstr "实型输出信号接口"

msgctxt "Modelica.Blocks.Math.Add3"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks computes output <strong>y</strong> as <em>sum</em> of the\r\n"
"three input signals <strong>u1</strong>, <strong>u2</strong> and <strong>u3</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"<strong>y</strong> = k1*<strong>u1</strong> + k2*<strong>u2</strong> + k3*<strong>u3</strong>;\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"Example:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"   parameter:   k1= +2, k2= -3, k3=1;\r\n"
"\r\n"
"results in the following equations:\r\n"
"\r\n"
"   y = 2 * u1 - 3 * u2 + u3;\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输出<strong>y</strong>计算为三个输入信号 <strong>u1</strong>、<strong>u2</strong>和<strong>u3</strong>之<em>和</em>：\r\n"
"</p>\r\n"
"<pre><code >y = k1*u1 + k2*u2 + k3*u3;</code></pre><p>\r\n"
"例如:\r\n"
"</p>\r\n"
"<pre><code >parameter:   k1= +2, k2= -3, k3=1;\r\n"
"\r\n"
"results in the following equations:\r\n"
"\r\n"
"y = 2 * u1 - 3 * u2 + u3;</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

