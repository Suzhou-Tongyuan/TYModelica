msgctxt "Modelica.Blocks.Tables.CombiTable1DTs"
msgid "Text files (*.txt);;MATLAB MAT-files (*.mat);;csv files (*.csv)"
msgstr "Text files (*.txt);;MATLAB MAT-files (*.mat);;csv files (*.csv)"

msgctxt "Modelica.Blocks.Tables.CombiTable1DTs"
