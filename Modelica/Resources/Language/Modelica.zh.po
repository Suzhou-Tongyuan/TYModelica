"</tr>\r\n"
"<tr>\r\n"
"<td>参考温度 T1Ref</td>\r\n"
"<td>20</td><td>&deg;C</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>温度系数 alpha20_1</td>\r\n"
"<td>0</td><td>1/K</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>初级漏感 L1sigma</td>\r\n"
"<td>78E-6</td><td>每相亨利</td>\r\n"
