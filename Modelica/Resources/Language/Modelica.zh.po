msgstr "输入信号的下限"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve.MinLimiter"
msgid "<html>\r\n"
"<p>\r\n"
"The block passes its input signal as output signal\r\n"
"as long as the input is above uMin. If this is not the case,\r\n"
"y=uMin is passed as output.\r\n"
"</p>\r\n"
