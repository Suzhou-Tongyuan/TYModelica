"  </tr>\r\n"
"\r\n"
"  <tr><td><a href=\"modelica://Modelica.Mechanics.MultiBody.Examples.Elementary.HeatLosses\">HeatLosses</a></td>\r\n"
"      <td> Demonstrate the modeling of heat losses.  </td>\r\n"
