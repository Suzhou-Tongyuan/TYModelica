msgctxt "Modelica.Electrical.Spice3.Basic.L_Inductor"
msgid "Ideal linear electrical inductor"
msgstr "理想线性电感"

msgctxt "Modelica.Electrical.Spice3.Basic.L_Inductor"
msgid "Inductance"
msgstr "电感"

msgctxt "Modelica.Electrical.Spice3.Basic.L_Inductor"
msgid "Initial value; used, if UIC is true"
msgstr "初始值；如果UIC为true，则使用"

msgctxt "Modelica.Electrical.Spice3.Basic.L_Inductor"
