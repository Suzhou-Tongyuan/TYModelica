msgctxt "Modelica.Magnetic.QuasiStatic.FundamentalWave.Losses.StrayLoad"
msgid "Model of stray load losses dependent on current and speed"
msgstr "取决于电流和速度的杂散负载损耗模型"

msgctxt "Modelica.Magnetic.QuasiStatic.FundamentalWave.Losses.StrayLoad"
