msgstr "用于连接向量的实型输入接口"

msgctxt "Modelica.Blocks.Interfaces"
msgid "<html>\r\n"
"<p>\r\n"
"Real input connector that is used for a vector of connectors,\r\n"
"for example <a href=\"modelica://Modelica.Blocks.Interfaces.PartialRealMISO\">PartialRealMISO</a>,\r\n"
"and has therefore a different icon as RealInput connector.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"实数输入连接器，用于向量连接，\r\n"
"例如<a href=\"modelica://Modelica.Blocks.Interfaces.PartialRealMISO\">PartialRealMISO</a>，\r\n"
"因此具有与实数输入接口不同的图标。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Interfaces"
msgid "Integer input connector used for vector of connectors"
msgstr "用于连接向量的整型输入接口"

msgctxt "Modelica.Blocks.Interfaces"
msgid "<html>\r\n"
"\r\n"
"<p>\r\n"
"Integer input connector that is used for a vector of connectors,\r\n"
"for example <a href=\"modelica://Modelica.Blocks.Interfaces.PartialIntegerMISO\">PartialIntegerMISO</a>,\r\n"
"and has therefore a different icon as IntegerInput connector.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"整数输入连接器，用于向量连接，例如<a href=\"modelica://Modelica.Blocks.Interfaces.PartialIntegerMISO\" target=\"\">PartialIntegerMISO</a>&nbsp;，因此具有与整数输入接口不同的图标。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Interfaces"
msgid "Boolean input connector used for vector of connectors"
msgstr "用于连接向量的布尔型输入接口"

msgctxt "Modelica.Blocks.Interfaces"
