msgctxt "Modelica.Blocks.Continuous.PID"
msgid "Proportional part of PID controller"
msgstr "PID控制器的比例部分"

msgctxt "Modelica.Blocks.Continuous.PID"
msgid "Integral part of PID controller"
msgstr "PID控制器的组成部分"

msgctxt "Modelica.Blocks.Continuous.PID"
msgid "Derivative part of PID controller"
msgstr "Derivative part of PID controller"

msgctxt "Modelica.Blocks.Continuous.PID"
msgid "Gain of PID controller"
msgstr "PID控制器的增益"

