"<p>\r\n"
"This is a model to collect the heat flows from <em>m</em> heatports to one single heatport.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"本模型实现m个热接口的热流量向单一热接口汇聚传输。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Thermal.HeatTransfer.Components.ThermalCollectorMatrix"
msgid "Collects Ns x Np heat flows"
msgstr "Ns x Np个热流汇聚"

msgctxt "Modelica.Thermal.HeatTransfer.Components.ThermalCollectorMatrix"
msgid "Number of rows"
msgstr "行数"

msgctxt "Modelica.Thermal.HeatTransfer.Components.ThermalCollectorMatrix"
