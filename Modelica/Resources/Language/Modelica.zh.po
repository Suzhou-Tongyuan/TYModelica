msgctxt "Modelica.Blocks.Nonlinear.DeadZone"
msgid "Provide a region of zero output"
msgstr "提供零输出区域"

msgctxt "Modelica.Blocks.Nonlinear.DeadZone"
msgid "Upper limits of dead zones"
msgstr "死区的上限"

msgctxt "Modelica.Blocks.Nonlinear.DeadZone"
msgid "Lower limits of dead zones"
msgstr "死区的下限"

msgctxt "Modelica.Blocks.Nonlinear.DeadZone"
msgid "<html>\r\n"
"<p>\r\n"
