msgctxt "Modelica.SIunits.Conversions.to_unit1"
msgid "Change the unit of a Real number to unit=\"1\""
msgstr "Change the unit of a Real number to unit=\"1\""

msgctxt "Modelica.SIunits.Conversions.to_unit1"
msgid "Real number"
msgstr "Real number"

msgctxt "Modelica.SIunits.Conversions.to_unit1"
msgid "Real number r with unit=\"1\""
msgstr "Real number r with unit=\"1\""

msgctxt "Modelica.SIunits.Conversions.to_unit1"
msgid "<html>\r\n"
"<h4>Syntax</h4>\r\n"
"<blockquote><pre>\r\n"
"SIunits.Conversions.<strong>to_unit1</strong>(r);\r\n"
"</pre></blockquote>\r\n"
"<h4>Description</h4>\r\n"
"<p>\r\n"
"The function call \"<code>Conversions.<strong>to_unit1</strong>(r)</code>\" returns r with unit=\"1\".\r\n"
"</p>\r\n"
"<h4>Example</h4>\r\n"
"<blockquote><pre>\r\n"
"  Modelica.SIunits.Velocity v = {3,2,1};\r\n"
"  Real direction[3](unit=\"1\") = to_unit1(v);   // Automatically vectorized call of to_unit1\r\n"
"</pre></blockquote>\r\n"
"</html>"
msgstr "<html>\r\n"
"<h4>Syntax</h4>\r\n"
"<blockquote><pre>\r\n"
"SIunits.Conversions.<strong>to_unit1</strong>(r);\r\n"
"</pre></blockquote>\r\n"
"<h4>Description</h4>\r\n"
"<p>\r\n"
"The function call \"<code>Conversions.<strong>to_unit1</strong>(r)</code>\" returns r with unit=\"1\".\r\n"
"</p>\r\n"
"<h4>Example</h4>\r\n"
"<blockquote><pre>\r\n"
"  Modelica.SIunits.Velocity v = {3,2,1};\r\n"
"  Real direction[3](unit=\"1\") = to_unit1(v);   // Automatically vectorized call of to_unit1\r\n"
"</pre></blockquote>\r\n"
"</html>"

