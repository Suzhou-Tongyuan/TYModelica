msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors"
msgid "Sensors to measure variables in magnetic networks"
msgstr "测量磁网变量的传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors"
msgid "<html>\r\n"
"<p>\r\n"
"For analysis of magnetic networks, only magnetic potential differences and magnetic flux are variables of interest. For that reason, a magnetic potential sensor is not provided.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"对于磁网络的分析，只有磁位差和磁通是感兴趣的变量。因此，不提供磁势传感器.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.ReferenceSensor"
msgid "Sensor of reference angle gamma"
msgstr "参考角度伽马传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.ReferenceSensor"
msgid "Reference angle"
msgstr "参考角"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.ReferenceSensor"
msgid "<html>\r\n"
"<p>This sensor determines the reference angle of the connected quasi-static magnetic system.\r\n"
"The integral of the angular frequency of the quasi-static magnetic system is equal to the reference angle.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>该传感器确定所连接的准静态磁系统的参考角度。\r\n"
"准静磁系统的角频率积分等于参考角.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.ReferenceSensor"
msgid "rad"
msgstr "rad"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.FrequencySensor"
msgid "Frequency sensor"
msgstr "频率传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.FrequencySensor"
msgid "<html>\r\n"
"<p>\r\n"
"This sensor can be used to measure the frequency of the reference system.\r\n"
"The integral of the angular frequency of the quasi-static magnetic system is equal to the reference angle.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该传感器可用于测量参考系统的频率。\r\n"
"准静磁系统的角频率积分等于参考角.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.FrequencySensor"
msgid "Hz"
msgstr "Hz"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticPotentialSensor"
msgid "Potential sensor"
msgstr "潜在的传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticPotentialSensor"
msgid "<html>\r\n"
"<p>\r\n"
"This sensor can be used to measure the complex magnetic potential <code>V_m</code> in a quasi-static magnetic system.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该传感器可用于测量准静态磁系统中的复磁势<code>V_m</code>.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticPotentialSensor"
msgid "A"
msgstr "A"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticPotentialDifferenceSensor"
msgid "Sensor to measure magnetic potential difference"
msgstr "测量磁电位差的传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticPotentialDifferenceSensor"
msgid "A"
msgstr "A"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticPotentialDifferenceSensor"
msgid "<html>\r\n"
"<p>\r\n"
"This sensor can be used to measure the complex magnetic potential difference <code>V_m</code>\r\n"
"in a quasi-static magnetic system.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该传感器可用于测量复磁位差<code>V_m</code>\r\n"
"在准静态磁系统中.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticFluxSensor"
msgid "Sensor to measure magnetic flux"
msgstr "测量磁通量的传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticFluxSensor"
msgid "Wb"
msgstr "Wb"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.MagneticFluxSensor"
msgid "<html>\r\n"
"<p>\r\n"
"This sensor can be used to measure the complex magnetic flux <code>Phi</code> of a quasi-static magnetic system.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该传感器可用于测量准静态磁系统的复磁通<码>Phi</码>.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient"
msgid "Transient fundamental wave sensors"
msgstr "瞬态基波传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient"
msgid "<html>\r\n"
"<p>This package contains sensors to be used with transient flux tubes models in order to provide information\r\n"
"for quasi-static parameters.</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>该包包含用于瞬态磁通管模型的传感器，以便提供信息\r\n"
"对于准静态参数.</p>\r\n"
"</html>"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient.FundamentalWavePermabilitySensor"
msgid "Sensor of fundamental wave permeability"
msgstr "基波渗透率传感器"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient.FundamentalWavePermabilitySensor"
msgid "Fundamental wave frequency"
msgstr "基波频率"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient.FundamentalWavePermabilitySensor"
