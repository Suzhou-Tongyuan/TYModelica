msgstr "定义固定或规定的边界条件"

msgctxt "Modelica.Fluid.Sources"
msgid "<html>\r\n"
"<p>\r\n"
"Package <strong>Sources</strong> contains generic sources for fluid connectors\r\n"
"to define fixed or prescribed ambient conditions.\r\n"
