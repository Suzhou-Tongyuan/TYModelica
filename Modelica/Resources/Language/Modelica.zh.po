msgctxt "Modelica.Blocks.Examples.Noise.UniformNoiseProperties"
msgid "Demonstrates the computation of properties for uniformly distributed noise"
msgstr "演示干扰特性均匀分布的计算"

msgctxt "Modelica.Blocks.Examples.Noise.UniformNoiseProperties"
msgid "Minimum value of band"
msgstr "带宽的最小值"

msgctxt "Modelica.Blocks.Examples.Noise.UniformNoiseProperties"
msgid "Maximum value of band"
msgstr "带宽的最大值"

