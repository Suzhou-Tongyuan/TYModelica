msgstr "展示带有二氧化碳控制功能的空间容积"

msgctxt "Modelica.Fluid.Examples.TraceSubstances.RoomCO2WithControls"
msgid "Atmospheric trace substance concentration, corresponding to 300 PPM CO2"
msgstr "大气微量物质浓度，相当于 300 PPM CO2"

