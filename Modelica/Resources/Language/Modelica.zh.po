msgstr "长度"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient.FundamentalWavePermabilitySensor"
msgid "Positive port of flux path"
msgstr "通量路径的正端口"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient.FundamentalWavePermabilitySensor"
msgid "Negative port of flux path"
msgstr "磁通路径的负端口"

msgctxt "Modelica.Magnetic.QuasiStatic.FluxTubes.Sensors.Transient.FundamentalWavePermabilitySensor"
