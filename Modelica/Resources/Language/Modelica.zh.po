msgstr "复合步骤与复合步骤内各步骤之间的通信端口"

msgctxt "Modelica.StateGraph.PartialCompositeStep"
msgid "= true, if step is active, otherwise the step is not active"
msgstr "=true，如果步骤已激活，否则步骤未激活"

msgctxt "Modelica.StateGraph.PartialCompositeStep"
msgid "Value of active in the next iteration"
msgstr "下一次迭代中的active值"

msgctxt "Modelica.StateGraph.PartialCompositeStep"
