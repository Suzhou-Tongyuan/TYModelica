msgid "Memory with data, lowest bit on left side"
msgstr "带数据的存储器，最低位在左侧"

msgctxt "Modelica.Electrical.Digital.Memories.DLATRAM"
msgid "<html>\r\n"
"<p>\r\n"
"Description in VHDL is given by <a href=\"http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities.vhd\">http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities.vhd</a>\r\n"
"</p>\r\n"
"<p><strong>Truth Table for high active read enable RE:</strong></p>\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"  <tr><td><strong>RE</strong></td>\r\n"
"      <td><strong>Addr</strong></td>\r\n"
"      <td><strong>DataOut</strong></td>\r\n"
"  </tr>\r\n"
"  <tr><td>0</td>  <td>*</td>              <td>Z over all</td>  </tr>\r\n"
"  <tr><td>1</td>  <td>  no X in Addr</td> <td>DataOut=m(Addr)</td>     </tr>\r\n"
"  <tr><td>1</td>  <td>X in Addr</td>      <td>X over all</td>  </tr>\r\n"
"  <tr><td>X</td>  <td>*</td>              <td>X over all</td>  </tr>\r\n"
"</table>\r\n"
"<p><strong>Truth Table for high active write enable WE:</strong></p>\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"  <tr><td><strong>WE</strong></td>\r\n"
"      <td><strong>Addr</strong></td>\r\n"
"      <td><strong>Memory</strong></td>\r\n"
"  </tr>\r\n"
"  <tr><td>0</td>  <td>*</td>              <td>no write</td>           </tr>\r\n"
"  <tr><td>1</td>  <td>no X in Addr</td>   <td>m(Addr)=DataIn</td>     </tr>\r\n"
"  <tr><td>1</td>  <td>X in Addr</td>      <td>no write</td>  </tr>\r\n"
"  <tr><td>X</td>  <td>no X in Addr</td>   <td>m(Addr)=X over all</td> </tr>\r\n"
"  <tr><td>X</td>  <td>X in Addr</td>      <td>no write</td>  </tr>\r\n"
"</table>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"*  = do not care\r\n"
"0  = L.'0' or L.'L'\r\n"
"1  = L.'1' or L.'H'\r\n"
"X  = L.'X' or L.'W' or L.'Z' or L.'-' or L.'U'\r\n"
"Z  = L.'Z'\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p><strong>Simultaneous read/write operations are allowed.\r\n"
"Firstly Write is carried out, then Read.</strong></p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"在VHDL中的描述请参考 <a href=\"http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities.vhd\">http://www.cs.sfu.ca/~ggbaker/reference/std_logic/src/std_logic_entities.vhd</a>\r\n"
"</p>\r\n"
"<p><strong>高电平激活的读使能 RE 的真值表：</strong></p>\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td><strong>RE</strong></td>\r\n"
"<td><strong>地址</strong></td>\r\n"
"<td><strong>数据输出</strong></td>\r\n"
"</tr>\r\n"
"<tr><td>0</td>  <td>*</td>              <td>全为 Z</td>  </tr>\r\n"
"<tr><td>1</td>  <td>  地址中没有 X</td> <td>数据输出=m(地址)</td>     </tr>\r\n"
"<tr><td>1</td>  <td>地址中有 X</td>      <td>全为 X</td>  </tr>\r\n"
"<tr><td>X</td>  <td>*</td>              <td>全为 X</td>  </tr>\r\n"
"</table>\r\n"
"<p><strong>高电平激活的写使能 WE 的真值表：</strong></p>\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td><strong>WE</strong></td>\r\n"
"<td><strong>地址</strong></td>\r\n"
"<td><strong>内存</strong></td>\r\n"
"</tr>\r\n"
"<tr><td>0</td>  <td>*</td>              <td>不写入</td>           </tr>\r\n"
"<tr><td>1</td>  <td>地址中没有 X</td>   <td>m(地址)=数据输入</td>     </tr>\r\n"
"<tr><td>1</td>  <td>地址中有 X</td>      <td>不写入</td>  </tr>\r\n"
"<tr><td>X</td>  <td>地址中没有 X</td>   <td>m(地址)=全为 X</td> </tr>\r\n"
"<tr><td>X</td>  <td>地址中有 X</td>      <td>不写入</td>  </tr>\r\n"
"</table>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"*  = 不关心\r\n"
"0  = L.'0' 或 L.'L'\r\n"
"1  = L.'1' 或 L.'H'\r\n"
"X  = L.'X' 或 L.'W' 或 L.'Z' 或 L.'-' 或 L.'U'\r\n"
"Z  = L.'Z'\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p><strong>允许同时进行读/写操作。\r\n"
"首先进行写入，然后进行读取。</strong></p>\r\n"
"</html>"

