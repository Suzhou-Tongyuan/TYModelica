msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic"
msgid "Library of blocks that operate on periodically and non-periodically clocked signals"
msgstr "对周期性和非周期性时钟信号进行操作的模块库"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.BooleanChange"
msgid "Indicate Boolean signal changing"
msgstr "指示布尔信号变化"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.BooleanChange"
msgid "Connector of Boolean input signal."
msgstr "布尔输入信号连接器。"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.BooleanChange"
msgid "Connector of Boolean output signal."
msgstr "布尔输出信号连接器。"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.BooleanChange"
msgid "change()"
msgstr "change()"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.BooleanChange"
msgid "<html><p>\r\n"
"This block is a synchronous version of\r\n"
"<a href=\"modelica://Modelica.Blocks.Math.BooleanChange\">Modelica.Blocks.Math.BooleanChange</a>.\r\n"
"It uses <code>previous</code> instead of the implicit <code>pre</code> of\r\n"
"<code>change</code> to set the Boolean output <code>y</code> to\r\n"
"<code>true</code> when the boolean input <code>u</code> changed. Thus, it's\r\n"
"logic is:</p>\r\n"
"<blockquote><pre>\r\n"
"if firstTick() then\r\n"
"  y = false;\r\n"
"else\r\n"
"  y = not (u == previous(u));\r\n"
"end if;\r\n"
"</pre></blockquote>\r\n"
"<p>\r\n"
"<strong>This block might be superfluous and replaced by\r\n"
"</strong><code>Modelica.Blocks.Math.BooleanChange</code><strong> when the semantics\r\n"
"of </strong><code>change</code><strong> are relaxed and well-defined for\r\n"
"clocked discrete-time partitions.</strong></p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"这个模块是 <a href=\"modelica://Modelica.Blocks.Math.BooleanChange\" target=\"\">Modelica.Blocks.Math.BooleanChange</a>&nbsp; 的同步版本。 它使用 <code>previous</code> 而不是 <code>change</code> 的隐式 <code>pre</code> 来设置 布尔输出 <code>y</code>，当布尔输入 <code>u</code> 发生变化时，将 <code>y</code> 设置为 <code>true</code>。 因此，它的逻辑是：\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<pre><code >if firstTick() then\r\n"
"  y = false;\r\n"
"else\r\n"
"  y = not (u == previous(u));\r\n"
"end if;\r\n"
"</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<span style=\"color: rgb(51, 51, 51);\"><strong>当时钟离散时间分区的</strong></span><code><strong>change</strong></code><span style=\"color: rgb(51, 51, 51);\"><strong>语义得到放宽并明确定义时，这个模块可能是多余的，可以由 </strong></span><code><strong>Modelica.Blocks.Math.BooleanChange</strong></code><span style=\"color: rgb(51, 51, 51);\"><strong>替代。</strong></span>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.UnitDelay"
msgid "Delay the clocked input signal for one sample period"
msgstr "将时钟输入信号延迟一个采样周期"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.UnitDelay"
msgid "Value of output signal at first clock tick"
msgstr "第一个时钟刻度时的输出信号值"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.UnitDelay"
msgid "1"
msgstr "1"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.UnitDelay"
msgid "z"
msgstr "z"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.UnitDelay"
msgid "y_start=%y_start"
msgstr "y_start=%y_start"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.UnitDelay"
msgid "<html>\r\n"
"<p>\r\n"
"This block describes a unit delay:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"// Time domain description\r\n"
"   y(ti) = previous(u(ti))\r\n"
"\r\n"
"// Discrete transfer function\r\n"
"           1\r\n"
"   y(z) = --- * u(z)\r\n"
"           z\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p>\r\n"
"that is, the output signal y is the input signal u at the\r\n"
"previous clock tick. At the first clock tick, the output\r\n"
"y is set to parameter y_start.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该模块描述了一个单元延迟：\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"// Time domain description\r\n"
"   y(ti) = previous(u(ti))\r\n"
"\r\n"
"// Discrete transfer function\r\n"
"           1\r\n"
"   y(z) = --- * u(z)\r\n"
"           z\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p>\r\n"
"也就是说，输出信号 y 就是前一个时钟周期的输入信号 u。在第一个时钟周期，输出 y 被设置为参数 y_start。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.FractionalDelay"
msgid "Delay the clocked input signal for a fractional multiple of the sample period"
msgstr "将时钟输入信号延迟至采样周期的整数倍"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.FractionalDelay"
msgid "Delay = interval() * shift/resolution"
msgstr "延迟 = 间隔() * 移位/分辨率"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.FractionalDelay"
msgid "Time quantization resolution of sample interval"
msgstr "采样间隔的时间量化分辨率"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.FractionalDelay"
msgid "The previous values of the inputs; u_last[1] = u, u_last[2] = previous(u_last[1]); u_last[3] = previous(u_last[2])"
msgstr "以前的输入值; u_last[1] = u, u_last[2] = previous(u_last[1]); u_last[3] = previous(u_last[2])"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.FractionalDelay"
msgid "Used to identify the first clock tick"
msgstr "Used to identify the first clock tick"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.FractionalDelay"
msgid "%shift/%resolution"
msgstr "%shift/%resolution"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.ClockToBoolean"
msgid "Block to translate clock signals to continuous Boolean events (each time the input clock ticks a rising Boolean output edge is produced)."
msgstr "该模块用于将时钟信号转换为连续的布尔事件(每次输入时钟跳变时，产生一个上升的布尔输出边缘)"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.ClockToBoolean"
msgid "Connector of clock input signal."
msgstr "时钟输入信号连接器。"

msgctxt "Modelica.Clocked.BooleanSignals.NonPeriodic.ClockToBoolean"
msgid "Connector of continuous Boolean output signal."
msgstr "连续布尔输出信号连接器。"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources"
msgid "Package of signal source blocks generating clocked simulation time based Boolean signals"
msgstr "生成基于时钟模拟时间的布尔信号的信号源模块包"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources"
msgid "<html>\r\n"
"<p>\r\n"
"This package provides <strong>source</strong> components akin to the blocks provided in\r\n"
"<a href=\"modelica://Modelica.Blocks.Sources\">Modelica.Blocks.Sources</a>, but with the difference\r\n"
"that they provide a <strong>clocked</strong> output signal.\r\n"
"</p>\r\n"
"<p>\r\n"
"As an effect it is not necessary to use an intermediate Sample block if the output signal\r\n"
"is connected to a system that requires a clocked input signal. Therefore, it it can be slightly more convenient\r\n"
"to use the blocks provided in this package than to use the blocks offered by <a href=\"modelica://Modelica.Blocks.Sources\">Modelica.Blocks.Sources</a>\r\n"
"(since one does not need to add an additional Sample block for the transition from a continuous time signal to a clocked signal).\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"这个包提供类似于 <a href=\"modelica://Modelica.Blocks.Sources\" target=\"\">Modelica.Blocks.Sources</a>&nbsp; &nbsp;中提供的 <strong>源</strong> 组件，<span style=\"color: rgb(51, 51, 51);\">但不同之处在于它们提供了一个时钟输出信号</span>。\r\n"
"</p>\r\n"
"<p>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">因此，如果输出信号连接到需要时钟输入信号的系统，就不需要使用中间的采样（Sample）模块。因此，使用这个包提供的模块比使用</span><a href=\"modelica://Modelica.Blocks.Sources\" target=\"\">Modelica.Blocks.Sources</a>&nbsp; <span style=\"color: rgb(51, 51, 51);\"> 中的模块稍微更加方便，因为不需要为了从连续时间信号转换到时钟信号而额外添加一个采样模块。</span>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Step"
msgid "Generate step signal of type Boolean"
msgstr "生成布尔类型的阶跃信号"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Step"
msgid "Time instant of step start"
msgstr "阶梯开始的时间瞬间"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Step"
msgid "Output before startTime"
msgstr "开始时间之前的输出"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Step"
msgid "startTime=%startTime"
msgstr "startTime=%startTime"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Step"
msgid "<html>\r\n"
"<p>The block is similar to the block in <a href=\"modelica://Modelica.Blocks.Sources.BooleanStep\">Modelica.Blocks.Sources.BooleanStep</a>,\r\n"
"but adapted to work in clocked partitions (by internal sampling of the continuous <strong>time</strong> variable).</p>\r\n"
"<p>\r\n"
"The Boolean output y is a step signal:\r\n"
"</p>\r\n"
"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Blocks/Sources/BooleanStep.png\" alt=\"BooleanStep.png\">\r\n"
"</div>\r\n"
"\r\n"
"<h4>Example</h4>\r\n"
"<p>\r\n"
"See model <a href=\"modelica://Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedStep\">Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedStep</a>.\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"这个模块类似于 <a href=\"modelica://Modelica.Blocks.Sources.BooleanStep\" target=\"\">Modelica.Blocks.Sources.BooleanStep</a>&nbsp; 中的模块， <span style=\"color: rgb(51, 51, 51);\">但经过调整以在时钟分区中工作（通过对连续</span><span style=\"color: rgb(51, 51, 51);\"><strong>时间</strong></span><span style=\"color: rgb(51, 51, 51);\">变量的内部采样）</span>。 \r\n"
"</p>\r\n"
"<p>\r\n"
" 布尔输出 y 是一个阶跃信号：\r\n"
"</p>\r\n"
"<p>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Blocks/Sources/BooleanStep.png\" alt=\"BooleanStep.png\" data-href=\"\" style=\"\"/>\r\n"
"</p>\r\n"
"<h4>Example</h4><p>\r\n"
"见模型 <a href=\"modelica://Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedStep\" target=\"\">Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedStep</a>&nbsp;. <br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "Generate pulse signal of type Boolean"
msgstr "生成布尔类型的脉冲信号"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "Width of pulse in % of period"
msgstr "脉冲宽度占周期的百分比"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "Time for one period"
msgstr "一个时段的时间"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "Time instant of first pulse"
msgstr "第一个脉冲的时间瞬间"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "Width of one pulse"
msgstr "一个脉冲的宽度"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "next = startTime + n*period, for smallest n such that next>simTime"
msgstr "next = startTime + n*period, 对于最小的 n，使得 next>simTime"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "Tolerance for numeric comparisons"
msgstr "数值比较的容差"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "%period"
msgstr "%period"

msgctxt "Modelica.Clocked.BooleanSignals.TimeBasedSources.Pulse"
msgid "<html>\r\n"
"<p>The block is similar to the block in <a href=\"modelica://Modelica.Blocks.Sources.BooleanPulse\">Modelica.Blocks.Sources.BooleanPulse</a>,\r\n"
"but adapted to work in clocked partitions (by internal sampling of the continuous <strong>time</strong> variable).\r\n"
"</p>\r\n"
"<p>\r\n"
"The Boolean output y is a pulse signal:\r\n"
"</p>\r\n"
"\r\n"
"<div>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Blocks/Sources/Pulse.png\" alt=\"Pulse.png\">\r\n"
"</div>\r\n"
"<h4>Example</h4>\r\n"
"<p>\r\n"
"See model <a href=\"modelica://Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedPulse\">Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedPulse</a>.\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"这个模块类似于 <a href=\"modelica://Modelica.Blocks.Sources.BooleanPulse\" target=\"\">Modelica.Blocks.Sources.BooleanPulse</a>&nbsp; 中的模块， <span style=\"color: rgb(51, 51, 51);\">但经过调整以在时钟分区中工作（通过对连续</span><span style=\"color: rgb(51, 51, 51);\"><strong>时间</strong></span><span style=\"color: rgb(51, 51, 51);\">变量的内部采样）</span>。\r\n"
"</p>\r\n"
"<p>\r\n"
"布尔输出 y 是一个脉冲信号：\r\n"
"</p>\r\n"
"<p>\r\n"
"<img src=\"modelica://Modelica/Resources/Images/Blocks/Sources/Pulse.png\" alt=\"Pulse.png\" data-href=\"\" style=\"\"/>\r\n"
"</p>\r\n"
"<h4>Example</h4><p>\r\n"
"见模型 <a href=\"modelica://Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedPulse\" target=\"\">Modelica.Clocked.Examples.Elementary.BooleanSignals.TimeBasedPulse</a>&nbsp;. <br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.BooleanSignals.TickBasedSources"
msgid "Package of signal source blocks generating clocked tick/sample based Boolean signals"
msgstr "生成基于时钟刻度/采样布尔信号的信号源块软件包"

msgctxt "Modelica.Clocked.BooleanSignals.TickBasedSources"
msgid "<html>\r\n"
"<p>This package provides <strong>source</strong> components akin to the blocks provided in <a href=\"modelica://Modelica.Blocks.Sources\">Modelica.Blocks.Sources</a>, but with the difference that they provide</p>\r\n"
"<ol>\r\n"
"<li>a <strong>clocked</strong> output signal and</li>\r\n"
"<li>are parametrized in terms of <strong>clock ticks</strong> rather than simulation time.</li>\r\n"
"</ol>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"<br>这个包提供类似于 <a href=\"modelica://Modelica.Blocks.Sources\" target=\"\">Modelica.Blocks.Sources</a>&nbsp; 中<br>提供的 <strong>源</strong> 组件，但不同之处在于它们提供<br>\r\n"
"</p>\r\n"
"<ol><li>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">一个时钟输出信号</span></li>\r\n"
"<li>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">以时钟周期为参数，而不是仿真时间</span>。</li>\r\n"
"</ol></html>"

msgctxt "Modelica.Clocked.BooleanSignals.TickBasedSources.Step"
msgid "Generate step signal of type Boolean"
msgstr "生成布尔类型的阶跃信号"

msgctxt "Modelica.Clocked.BooleanSignals.TickBasedSources.Step"
