msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.SquirrelCage"
msgid "Currents out from squirrel cage"
msgstr "松鼠笼输出电流"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.SquirrelCage"
msgid "%name"
msgstr "%name"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.SquirrelCage"
msgid "<html>\r\n"
"<p>\r\n"
"Model of a squirrel cage / symmetrical damper cage in two axis.\r\n"
"</p>\r\n"
"<p>\r\n"
"The squirrel cage has an optional (conditional) HeatPort,\r\n"
"which can be enabled or disabled by the Boolean parameter useHeatPort.\r\n"
"Temperatures of both axis are the same, both losses are added.\r\n"
"Material properties alpha of both axis are the same.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"两轴中的松鼠笼/对称阻尼笼模型。\r\n"
"</p>\r\n"
"<p>\r\n"
"松鼠笼具有一个可选的(条件)HeatPort，可以通过布尔参数useHeatPort启用或禁用。\r\n"
"两个轴的温度相同，两个损耗相加。\r\n"
"两个轴的材料特性alpha相同。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Squirrel Cage"
msgstr "阻尼笼"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Stray inductance in d-axis per phase translated to stator"
msgstr "每相转换到定子的d轴阻尼杂散电感"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Stray inductance in q-axis per phase translated to stator"
msgstr "每相转换到定子的q轴阻尼杂散电感"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Resistance in d-axis per phase translated to stator at T_ref"
msgstr "每相转换到T_ref时定子的d轴阻尼电阻"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Resistance in q-axis per phase translated to stator at T_ref"
msgstr "每相转换到T_ref时定子的q轴阻尼电阻"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Reference temperature of both resistances in d- and q-axis"
msgstr "d-轴和q-轴阻尼电阻的参考温度"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Temperature coefficient of both resistances in d- and q-axis at T_ref"
msgstr "在T_ref时d-轴和q-轴阻尼电阻的温度系数"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Actual resistance = Rrd*(1 + alpha*(T_heatPort - T_ref))"
msgstr "实际电阻 = Rrd*(1 + alpha*(T_heatPort - T_ref))"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Actual resistance = Rrq*(1 + alpha*(T_heatPort - T_ref))"
msgstr "实际电阻 = Rrq*(1 + alpha*(T_heatPort - T_ref))"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Currents out from damper"
msgstr "阻尼输出电流"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "Damper losses"
msgstr "阻尼损耗"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "%name"
msgstr "%name"

msgctxt "Modelica.Electrical.Machines.BasicMachines.Components.DamperCage"
msgid "<html>\r\n"
"<p>\r\n"
"Model of an asymmetrical damper cage in two axis.\r\n"
"</p>\r\n"
"<p>\r\n"
"The damper cage has an optional (conditional) HeatPort,\r\n"
"which can be enabled or disabled by the Boolean parameter useHeatPort.\r\n"
"Temperatures of both axis are the same, both losses are added.\r\n"
"Material properties alpha can be set differently for both d- and q-axis,\r\n"
"although reference temperature for both resistances is the same.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"两轴中的不对称阻尼笼模型。\r\n"
"</p>\r\n"
"<p>\r\n"
"阻尼笼具有一个可选的(条件)HeatPort，\r\n"
"可以通过布尔参数useHeatPort启用或禁用。\r\n"
"两个轴的温度相同，两个损耗相加。\r\n"
"alpha的材料特性可以分别设置在d轴和q轴，\r\n"
"尽管两个电阻的参考温度相同。\r\n"
"</p>\r\n"
"</html>"

