"<a href=\"modelica://Modelica.Electrical.Polyphase.UsersGuide.PhaseOrientation\">用户指南</a> 有关对称分量和方向的信息。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Electrical.QuasiStatic.Polyphase.Blocks.SingleToPolyphase"
msgid "Extends complex phase signal to complex polyphase signals using symmetricOrientation"
msgstr "使用对称方向将复相信号扩展为复多相信号"

