msgctxt "Modelica.Electrical.Analog.Examples.OpAmps.SignalGenerator"
msgid "Negative supply"
msgstr "负输入"

msgctxt "Modelica.Electrical.Analog.Examples.OpAmps.SignalGenerator"
msgid "Desired amplitude of output"
msgstr "输出所需的峰值电压"

msgctxt "Modelica.Electrical.Analog.Examples.OpAmps.SignalGenerator"
msgid "Arbitrary resistance for Schmitt trigger part"
msgstr "Schmitt-Trigger的可调电阻"

msgctxt "Modelica.Electrical.Analog.Examples.OpAmps.SignalGenerator"
msgid "Calculated resistance for Schmitt trigger to reach VAmp"
msgstr "为达到VAmp的Schmitt触发器所需电阻"

