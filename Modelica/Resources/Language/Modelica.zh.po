"\r\n"
"<tr><td colspan=\"2\"><strong>Mechanics.Rotational.</strong></td></tr>\r\n"
"<tr><td> OneWayClutch<br>LossyGear</td>\r\n"
"          <td> 用新变量\"unitAngularAcceleration\"和重写方程\r\n"
