msgid "The u-buffer [u(i-1), u(i-2), ..., u(size(a,1)-1)] is initialized with u(i=1)*cBufStart"
msgstr "系数 u 缓冲区 [u(i-1)，u(i-2)，...，u(size(a,1)-1)] 以 u(i=1)*cBufStartof FIR 滤波器初始化。"

