msgctxt "Modelica.Blocks.Examples.BooleanNetwork1"
msgid "Demonstrates the usage of blocks from Modelica.Blocks.MathBoolean"
msgstr "演示如何使用来自Modelica.Blocks.MathBoolean的模块"

msgctxt "Modelica.Blocks.Examples.BooleanNetwork1"
