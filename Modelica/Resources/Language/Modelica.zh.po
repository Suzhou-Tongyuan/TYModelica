msgid "Outlet duct"
msgstr "出口管道"

msgctxt "Modelica.Fluid.Examples.TraceSubstances.RoomCO2WithControls"
msgid "Trace substance at duct inlet"
msgstr "管道入口处的微量物质"

msgctxt "Modelica.Fluid.Examples.TraceSubstances.RoomCO2WithControls"
