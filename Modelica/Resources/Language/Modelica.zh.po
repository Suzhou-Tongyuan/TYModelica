"<p style=\"text-align: center;\"><img src=\"modelica://Modelica/Resources/Images/Math/log10.png\" alt=\"log10.png\" data-href=\"\" style=\"\">\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.WrapAngle"
msgid "Wrap angle to interval ]-pi,pi] or [0,2*pi["
msgstr "将角度限制在区间[-pi,pi]或[0,2*pi]"

msgctxt "Modelica.Blocks.Math.WrapAngle"
msgid "Use only positive output range, if true"
msgstr "如果为真，只使用正输出范围"

msgctxt "Modelica.Blocks.Math.WrapAngle"
msgid "<html>\r\n"
"<p>\r\n"
"This blocks wraps the input angle into the interval ]-pi,pi], if <code>positiveRange == false</code>.\r\n"
"Otherwise the input angle <code>u</code> is wrapped to the interval [0,2*pi[.\r\n"
"</p>\r\n"
"\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"如果<code>positiveRange == false</code>，\r\n"
"则此模块会将输入的角度限制在区间 [-pi,pi] 中。\r\n"
"否则，输入的角度<code>u</code>将被限制到区间 [0,2*pi]。\r\n"
"</p>\r\n"
"\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.RealToInteger"
msgid "Convert Real to Integer signal"
msgstr "将实数信号转换为整数信号"

msgctxt "Modelica.Blocks.Math.RealToInteger"
msgid "Connector of Real input signal"
msgstr "实数输入信号接口"

msgctxt "Modelica.Blocks.Math.RealToInteger"
msgid "Connector of Integer output signal"
msgstr "整数输出信号接口"

msgctxt "Modelica.Blocks.Math.RealToInteger"
msgid "R"
msgstr "R"

msgctxt "Modelica.Blocks.Math.RealToInteger"
msgid "I"
msgstr "I"

msgctxt "Modelica.Blocks.Math.RealToInteger"
msgid "<html>\r\n"
"<p>\r\n"
"This block computes the output <strong>y</strong>\r\n"
"as <em>nearest integer value</em> of the input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = <strong>integer</strong>( <strong>floor</strong>( u + 0.5 ) )  for  u &gt; 0;\r\n"
"y = <strong>integer</strong>( <strong>ceil </strong>( u - 0.5 ) )  for  u &lt; 0;\r\n"
"</pre></blockquote>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块将输入<strong>u</strong>的输出<strong>y</strong>计算为<em>最接近的整数值 </em>：\r\n"
"</p>\r\n"
"<pre><code >y = integer( floor( u + 0.5 ) )  for  u &gt; 0;\r\n"
"y = integer( ceil ( u - 0.5 ) )  for  u &lt; 0;</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Blocks.Math.IntegerToReal"
msgid "Convert Integer to Real signals"
msgstr "将整数信号转换为实数信号"

msgctxt "Modelica.Blocks.Math.IntegerToReal"
msgid "Connector of Integer input signal"
msgstr "整数输入信号接口"

msgctxt "Modelica.Blocks.Math.IntegerToReal"
msgid "Connector of Real output signal"
msgstr "实数输出信号接口"

msgctxt "Modelica.Blocks.Math.IntegerToReal"
msgid "I"
msgstr "I"

msgctxt "Modelica.Blocks.Math.IntegerToReal"
msgid "R"
msgstr "R"

msgctxt "Modelica.Blocks.Math.IntegerToReal"
msgid "<html>\r\n"
"<p>\r\n"
"This block computes the output <strong>y</strong>\r\n"
"as <em>Real equivalent</em> of the Integer input <strong>u</strong>:\r\n"
"</p>\r\n"
"<blockquote><pre>\r\n"
"y = u;\r\n"
"</pre></blockquote>\r\n"
"<p>where <strong>u</strong> is of Integer and <strong>y</strong> of Real type.</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
