"\r\n"
"<tr><td valign=\"top\">us</td>\r\n"
"    <td valign=\"top\">micro seconds (= 1/(1000*1000) seconds)</td></tr>\r\n"
"\r\n"
"<tr><td valign=\"top\">ns</td>\r\n"
"    <td valign=\"top\">nano seconds (= 1/(1000*1000*1000) seconds)</td></tr>\r\n"
