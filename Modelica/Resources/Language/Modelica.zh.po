msgstr "<html>\r\n"
"<table border=\"1\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><th>Date</th> <th align=\"left\">Description</th></tr>\r\n"
"\r\n"
"<tr><td> June 22, 2015 </td>\r\n"
"    <td>\r\n"
"\r\n"
"<table border=\"0\">\r\n"
"<tr><td>\r\n"
"         <img src=\"modelica://Modelica/Resources/Images/Logos/dlr_logo.png\" alt=\"DLR logo\">\r\n"
