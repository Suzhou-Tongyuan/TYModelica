msgstr "要插值的表格列数"

msgctxt "Modelica.Blocks.Tables.CombiTable1Dv"
msgid "Table data interpretation"
msgstr "表格数据解释"

msgctxt "Modelica.Blocks.Tables.CombiTable1Dv"
msgid "Smoothness of table interpolation"
msgstr "表格插值的平滑度"

msgctxt "Modelica.Blocks.Tables.CombiTable1Dv"
