"\r\n"
"<tr><td valign=\"top\">d</td>\r\n"
"    <td valign=\"top\">day (= 24*60*60 seconds)</td></tr>\r\n"
"\r\n"
"<tr><td valign=\"top\">h</td>\r\n"
"    <td valign=\"top\">hour (= 60*60 seconds)</td></tr>\r\n"
"\r\n"
"<tr><td valign=\"top\">m</td>\r\n"
"    <td valign=\"top\">minute (= 60 seconds)</td></tr>\r\n"
"\r\n"
"<tr><td valign=\"top\">s</td>\r\n"
