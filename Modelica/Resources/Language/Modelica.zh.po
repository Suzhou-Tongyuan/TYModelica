msgctxt "Modelica.Clocked.IntegerSignals.Interfaces.PartialClockedSISO"
msgid "Block with clocked single input and clocked single output Integer signals"
msgstr "带时钟单输入和时钟单输出整数信号的模块"

msgctxt "Modelica.Clocked.IntegerSignals.Interfaces.PartialClockedSISO"
