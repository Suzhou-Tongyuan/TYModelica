msgctxt "Modelica.Fluid.Dissipation.Utilities.Functions.General.SmoothPower"
msgid "Limiting the derivative of function y = if x>=0 then x^pow else -(-x)^pow"
msgstr "限制函数如果 x>=0 则 y = x^pow 否则 y = -(-x)^pow 的导数"

msgctxt "Modelica.Fluid.Dissipation.Utilities.Functions.General.SmoothPower"
msgid "Input variable"
msgstr "输入变量"

msgctxt "Modelica.Fluid.Dissipation.Utilities.Functions.General.SmoothPower"
msgid "Range for interpolation"
msgstr "插值范围"

msgctxt "Modelica.Fluid.Dissipation.Utilities.Functions.General.SmoothPower"
msgid "Exponent for x"
msgstr "x 的指数"

