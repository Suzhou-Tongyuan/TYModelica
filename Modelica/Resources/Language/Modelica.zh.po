msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Return solution of the discrete-time Sylvester equation A*X*B + sgn*X = C"
msgstr "返回离散时间Sylvester方程A*X*B + sgn*X = C的解"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Square matrix A in A*X*B + sgn*X = C"
msgstr "方阵A中的A*X*B + sgn*X = C"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Square matrix B in A*X*B + sgn*X = C"
msgstr "方阵B在A*X*B + sgn*X = C"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Rectangular matrix C in A*X*B + sgn*X = C"
msgstr "矩形矩阵C在A*X*B + sgn*X = C"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "= true, if A has already Hessenberg form"
msgstr "= true，如果A已经是海森伯格形式"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "= true, if B' has already real Schur form"
msgstr "= true，如果B'已经是实舒尔形式"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Specifies the sign in A*X*B + sgn*X = C"
msgstr "指定A*X*B + sgn*X = C中的符号"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Tolerance"
msgstr "容忍度"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Hessenberg form of A, i.e., H=U'AU"
msgstr "A 的海森伯形式, i.e., H=U'AU"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Transformation matrix U for H=U'AU"
msgstr "变换矩阵 U 为 H=U'AU"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "RSF form of B, i.e., S=Z'BZ"
msgstr "RSF 形式的 B, i.e., S=Z'BZ"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
msgid "Transformation matrix Z for S=Z'BZ"
msgstr "变换矩阵 Z 用于 S=Z'BZ"

msgctxt "Modelica.Math.Matrices.discreteSylvester"
