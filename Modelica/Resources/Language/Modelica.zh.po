"<tr>\r\n"
"<td>d轴的阻尼电阻</td>\r\n"
"<td>0.04</td><td>参考温度下的欧姆</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>q轴的阻尼电阻</td>\r\n"
"<td>同d轴</td><td> </td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>参考温度TrRef</td>\r\n"
"<td>20</td><td>&deg;C</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>温度系数alpha20r </td>\r\n"
"<td>0</td><td>1/K</td>\r\n"
"</tr>\r\n"
"<tr>\r\n"
"<td>d轴的阻尼漏感XDds</td>\r\n"
