msgstr "孔口直径"

msgctxt "Modelica.Fluid.Fittings.SimpleGenericOrifice"
msgid "Loss factor for flow of port_a -> port_b"
msgstr "从a接口流向b接口的流量损失因数"

msgctxt "Modelica.Fluid.Fittings.SimpleGenericOrifice"
msgid "= false to obtain zeta from dp_nominal and m_flow_nominal"
msgstr "false: 从 dp_nominal 和 m_flow_nominal 得到 zeta"

msgctxt "Modelica.Fluid.Fittings.SimpleGenericOrifice"
