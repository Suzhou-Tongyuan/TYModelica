"AlBr      BeBr            CH3N2CH3        D2O     KBO2     Ne      SiBr2\r\n"
"AlBr2     BeBr2           C2H5OH          D2O2    KBr      Ne+     SiBr3\r\n"
"AlBr3     BeCl            CH3OCH3         D2S     KCN      Ni      SiBr4\r\n"
"AlC       BeCl2           CH3O2CH3        e-      KCl      Ni+     SiC\r\n"
"AlC2      BeF             CCN             F       KF       Ni-     SiC2\r\n"
"AlCl      BeF2            CNC             F+      KH       NiCl    SiCl\r\n"
