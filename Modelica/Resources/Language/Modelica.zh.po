msgstr "第一个时钟周期的输出信号值"

msgctxt "Modelica.Clocked.IntegerSignals.NonPeriodic.UnitDelay"
msgid "1"
msgstr "1"

msgctxt "Modelica.Clocked.IntegerSignals.NonPeriodic.UnitDelay"
msgid "z"
