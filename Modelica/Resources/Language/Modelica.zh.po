"      矩阵a的行数M >= 0.\r\n"
"\r\n"
"N       (输入) INTEGER\r\n"
"      矩阵a的列数N >= 0.\r\n"
"\r\n"
"NRHS    (输入) INTEGER\r\n"
"      右手边的个数，也就是NRHS >= 0.\r\n"
"\r\n"
