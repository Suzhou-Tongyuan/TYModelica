msgstr "len"

msgctxt "Modelica.ComplexBlocks.ComplexMath.PolarToComplex"
msgid "phi"
msgstr "phi"

msgctxt "Modelica.ComplexBlocks.ComplexMath.PolarToComplex"
msgid "C"
msgstr "C"

msgctxt "Modelica.ComplexBlocks.ComplexMath.PolarToComplex"
msgid "<html>\r\n"
"<p>Converts the Real inputs <em>len</em> (length, absolute) and <em>phi</em> (angle, argument) to the Complex output <em>y</em>.</p>\r\n"
