msgstr "转动副1的轴方向向量，在frame_a中的解析"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Universal"
msgid "Axis of revolute joint 2 resolved in frame_b"
msgstr "转动副2的轴方向向量，在frame_a中的解析"

msgctxt "Modelica.Mechanics.MultiBody.Joints.Universal"
