msgid "Operational temperature of permanent magnet"
msgstr "永磁体的工作温度"

msgctxt "Modelica.Electrical.Machines.BasicMachines.DCMachines.DC_PermanentMagnet"
msgid "Operational temperatures"
msgstr "操作温度"

msgctxt "Modelica.Electrical.Machines.BasicMachines.DCMachines.DC_PermanentMagnet"
msgid "Field excitation inductance"
msgstr "励磁电感"

msgctxt "Modelica.Electrical.Machines.BasicMachines.DCMachines.DC_PermanentMagnet"
