msgctxt "Modelica.Blocks.Continuous.Internal.Filter.roots.bandStop"
msgid "Imaginary parts of complex conjugate eigenvalues"
msgstr "复共轭特征值的虚部"

msgctxt "Modelica.Blocks.Continuous.Internal.Filter.roots.bandStop"
msgid "Gains of input terms"
