msgstr "额定开度"

msgctxt "Modelica.Fluid.Valves.BaseClasses.PartialValve"
msgid "= true, if opening is filtered with a 2nd order CriticalDamping filter"
msgstr "true: 开度用2阶临界阻尼滤波器进行滤波"

