msgctxt "Modelica.Clocked.ClockSignals"
msgid "Library of blocks for clocked signals"
msgstr "时钟信号模块库"

msgctxt "Modelica.Clocked.ClockSignals"
msgid "<html>\r\n"
"<p>\r\n"
"This package contains blocks that transform a clock signal, by\r\n"
"sub-, super-, and shift-sampling a clock. For an introduction\r\n"
"to clocks see\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"本包包含将时钟信号进行子采样、超采样和移位采样的模块。\n"
"有关时钟的介绍，请参阅\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks"
msgid "Library of blocks that generate clocks"
msgstr "生成时钟的模块库"

msgctxt "Modelica.Clocked.ClockSignals.Clocks"
msgid "<html>\r\n"
"<p>\r\n"
"This package contains blocks that generate clock signals. For an introduction\r\n"
"to clocks see\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该软件包包含生成时钟信号的模块。有关时钟的请参见\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicRealClock"
msgid "Generate a periodic clock signal with a period defined by a Real number"
msgstr "生成周期由实数定义的周期时钟信号"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicRealClock"
msgid "Period of clock (defined as Real number)"
msgstr "时钟周期（定义为实数）"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicRealClock"
msgid "%period"
msgstr "%period"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicRealClock"
msgid "%solverMethod"
msgstr "%solverMethod"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicRealClock"
msgid "<html>\r\n"
"<p>\r\n"
"This component generates a periodic clock that starts ticking when\r\n"
"the simulation starts. The <strong>period</strong> is defined in seconds\r\n"
"by a <strong>Real</strong> number. If clocks are synchronized relatively to each other\r\n"
"then only one of the clocks can be defined with PeriodicRealClock.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"For an introduction to clocks see\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"If exact, integer based, time synchronization with absolute period definitions is\r\n"
"desired, use block\r\n"
"<a href=\"modelica://Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock\">PeriodicExactClock</a>\r\n"
"to generate a periodic clock signal.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"If a clock is associated to a clocked continuous-time partition, then an <strong>integrator</strong>\r\n"
"has to be defined that is used to integrate the partition from the previous\r\n"
"to the current clock tick. This is performed by setting parameter <strong>useSolver</strong>\r\n"
"= <strong>true</strong> and defining the integration method as String with\r\n"
"parameter <strong>solver</strong>. Both parameters are in tab <strong>Advanced</strong>.\r\n"
"For an example, see\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Systems.ControlledMixingUnit\">Examples.Systems.ControlledMixingUnit</a>.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p style=\"text-align: start;\">该组件生成一个周期性时钟，在仿真开始时开始计时。<strong>周期</strong>通过一个<strong>实数</strong>定义，单位为秒。如果时钟之间是相对同步的，则只能使用 PeriodicRealClock 定义其中一个时钟。\r\n"
"</p>\r\n"
"<p style=\"text-align: start;\">有关时钟的介绍，请参阅<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\" target=\"\">UsersGuide.Clocks</a>&nbsp;。如果需要精确的基于整数的时间同步，并且定义绝对周期，请使用 &nbsp;<a href=\"modelica://Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock\" target=\"\">PeriodicExactClock</a>&nbsp; 块生成周期性时钟信号。\r\n"
"</p>\r\n"
"<p style=\"text-align: start;\">如果时钟与连续时间分区相关联，则必须定义一个<strong>积分器</strong>，用于将分区从上一个时钟滴答整合到当前时钟滴答。这通过设置参数 <strong>useSolver</strong> = <strong>true</strong> &nbsp;并将积分方法定义为字符串形式的参数<strong> solver</strong> 来实现。两个参数都位于<strong>高级</strong>选项卡中。有关示例，请参阅 <a href=\"modelica://Modelica.Clocked.Examples.Systems.ControlledMixingUnit\" target=\"\">Examples.Systems.ControlledMixingUnit</a>&nbsp;。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "Generate a periodic clock signal with a period defined by an Integer number with resolution"
msgstr "生成一个周期性时钟信号，其周期由一个整数定义，并且具有分辨率"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "Sample factor with respect to resolution"
msgstr "与分辨率有关的采样系数"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "Clock resolution"
msgstr "时钟分辨率"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "Table to convert from Resolution to Integer clock resolution"
msgstr "将分辨率转换为整数时钟分辨率的表格"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "%factor %resolution"
msgstr "%factor %resolution"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "%solverMethod"
msgstr "%solverMethod"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.PeriodicExactClock"
msgid "<html>\r\n"
"<p>\r\n"
"This component generates a periodic clock that starts ticking when\r\n"
"the simulation starts. The <strong>period</strong> is defined as the product\r\n"
"of a resolution, defined with enumeration\r\n"
"<a href=\"modelica://Modelica.Clocked.Types.Resolution\">Resolution</a>,\r\n"
"and Integer parameter <strong>factor</strong>. Internally, the period is\r\n"
"represented as a rational number. All clocks with rational number definitions\r\n"
"are exactly time synchronized to each other.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"Example:\r\n"
"</p>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"import Modelica.Clocked.ClockSignals.Clocks;\r\n"
"import Modelica.Clocked.Types;\r\n"
"Clocks.PeriodicExactClock periodicClock(factor=10,\r\n"
"                                        resolution=Types.Resolution.ms);\r\n"
"// Clock ticks every 1/100 seconds\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p>\r\n"
"For an introduction to clocks see\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"If a clock is associated to a clocked continuous-time partition, then an <strong>integrator</strong>\r\n"
"has to be defined that is used to integrate the partition from the previous\r\n"
"to the current clock tick. This is performed by setting parameter <strong>useSolver</strong>\r\n"
"= <strong>true</strong> and defining the integration method as String with\r\n"
"parameter <strong>solver</strong>. Both parameters are in tab <strong>Advanced</strong>.\r\n"
"For an example, see\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Systems.ControlledMixingUnit\">Examples.Systems.ControlledMixingUnit</a>.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"这个组件生成一个周期性时钟，\r\n"
"在仿真开始时开始计时。\r\n"
"<strong>factor</strong> 由枚举类型 <a href=\"modelica://Modelica.Clocked.Types.Resolution\">Resolution</a> 定义的分辨率和整数参数 <strong>factor</strong> 的乘积确定。\r\n"
"在内部，周期被表示为一个有理数。\r\n"
"所有使用有理数定义的时钟在时间上都是精确同步的。\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"例如:\r\n"
"</p>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"import Modelica.Clocked.ClockSignals.Clocks;\r\n"
"import Modelica.Clocked.Types;\r\n"
"Clocks.PeriodicExactClock periodicClock(factor=10,\r\n"
"                                        resolution=Types.Resolution.ms);\r\n"
"// Clock ticks every 1/100 seconds\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p>\r\n"
"有关时钟的介绍请参见\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"如果时钟与时钟驱动的连续时间分区相关联，\r\n"
"则必须定义一个 <strong>integrator</strong>，\r\n"
"用于从前一个时钟周期集成到当前时钟周期。\r\n"
"这是通过设置参数 <strong>useSolver</strong> = <strong>true</strong> 并\r\n"
"定义积分方法为 String 类型的 <strong>solver</strong> 参数来实现的，\r\n"
"这两个参数位于 <strong>Advanced</strong> 选项卡中。\r\n"
"示例可参见\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Systems.ControlledMixingUnit\">Examples.Systems.ControlledMixingUnit</a>.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.EventClock"
msgid "Generate a clock signal when the Boolean input changes from false to true"
msgstr "当布尔输入从假变为真时产生时钟信号"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.EventClock"
msgid "%solverMethod"
msgstr "%solverMethod"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.EventClock"
msgid "<html>\r\n"
"<p>\r\n"
"This component generates a clock signal triggered by a continuous-time\r\n"
"Boolean input signal u: Whenever the Boolean input signal <strong>u</strong>\r\n"
"changes from <strong>false</strong> to <strong>true</strong>, then the output\r\n"
"clock signal <strong>y</strong> ticks.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"For an introduction to clocks see\r\n"
"<a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\">UsersGuide.Clocks</a>.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"If a clock is associated to a clocked continuous-time partition, then an <strong>integrator</strong>\r\n"
"has to be defined that is used to integrate the partition from the previous\r\n"
"to the current clock tick. This is performed by setting parameter <strong>useSolver</strong>\r\n"
"= <strong>true</strong> and defining the integration method as String with\r\n"
"parameter <strong>solver</strong>. Both parameters are in tab <strong>Advanced</strong>.\r\n"
"For an example, see\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Systems.ControlledMixingUnit\">Examples.Systems.ControlledMixingUnit</a>.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"这个组件生成一个时钟信号， 由连续时间的布尔输入信号 u 触发： 每当布尔输入信号 <strong>u</strong> 从 <strong>false</strong> 变为 <strong>true</strong> 时， 输出的时钟信号 <strong>y</strong> 就会滴答计时。\r\n"
"</p>\r\n"
"<p>\r\n"
"有关时钟的介绍请参阅 <a href=\"modelica://Modelica.Clocked.UsersGuide.Clocks\" target=\"\">UsersGuide.Clocks</a>&nbsp;.\r\n"
"</p>\r\n"
"<p>\r\n"
"如果时钟与时钟连续时间分区相关联， 则必须定义一个 <strong>积分器</strong>， 用于从上一个时钟刻度到当前时钟刻度对分区进行积分。 具体方法是设置参数 <strong>useSolver</strong> = <strong>true</strong>， 并使用参数 <strong>solver</strong> 将积分方法定义为字符串。 这两个参数都在 “<strong>高级</strong>“选项卡中。示例请参见 <a href=\"modelica://Modelica.Clocked.Examples.Systems.ControlledMixingUnit\" target=\"\">Examples.Systems.ControlledMixingUnit</a>&nbsp;.\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational"
msgid "Library of blocks that generate a clock tick each time an observed input angle changes"
msgstr "每当观察到的输入角度发生变化时，就会生成一个时钟脉冲的模块库"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.PartialRotationalClock"
msgid "Base class for event clocks that generate a clock tick each time an observed input angle changes"
msgstr "用于生成时钟跳变的事件时钟基类，每次观察到的输入角度变化时生成一次时钟跳变"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.PartialRotationalClock"
msgid "Input angle observed for generating clock ticks."
msgstr "用于生成时钟跳变的输入角度"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.PartialRotationalClock"
msgid "Rotation direction (sign: +1 or -1). Sampled with the provided clock signal\r\n"
"     'y'."
msgstr "旋转方向(符号：+1或-1)。通过提供的时钟信号‘y’进行采样"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.PartialRotationalClock"
msgid "= true, if the rotation direction of the observed angle changed since the last tick of y', otherwise false. Sampled with the provided clock signal y."
msgstr "如果自上次‘y’时钟跳变以来，观察到的角度的旋转方向发生了变化，则为真；否则为假。通过提供的时钟信号‘y’进行采样"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.RotationalClock"
msgid "Event clock generating a clock tick each time an observed input angle changed for a rotational-interval given as variable input"
msgstr "每当观察到的输入角度发生变化时，基于给定的旋转间隔(作为可变输入)生成时钟跳变的事件时钟"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.RotationalClock"
msgid "Rotational-interval the input angle must be changed to trigger the next clock tick"
msgstr "输入角度必须变化达到的能触发下一个时钟跳变的旋转间隔"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.RotationalClock"
msgid "<html>\r\n"
"    For a simple example cf. the\r\n"
"    <a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.RotationalSample\">rotational sampling example</a>.\r\n"
"    </html>"
msgstr "<html>\r\n"
"    对于一个简单的例子，请参见\r\n"
"    <a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.RotationalSample\">rotational sampling example</a>.\r\n"
"    </html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.FixedRotationalClock"
msgid "Event clock generating a clock tick each time an observed input angle changed for a certain, constant rotational-interval"
msgstr "事件时钟在每次观察到输入角度变化达到一定的恒定旋转间隔时生成一个时钟跳变"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.FixedRotationalClock"
msgid "Rotational-interval the input angle must be changed to trigger the next clock tick"
msgstr "旋转间隔：输入角度必须变化才能触发下一个时钟滴答"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Rotational.FixedRotationalClock"
msgid "%trigger_interval%"
msgstr "%trigger_interval%"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical"
msgid "Library of blocks for combining several input clock signals by logical combinators"
msgstr "通过逻辑组合器将多个输入时钟信号组合在一起的模块库"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.PartialLogicalClock"
msgid "Logical clock combining arbitrary many input clock signals according to a replaceable logical combinator"
msgstr "按照可替换的逻辑组合器将任意多个输入时钟信号组合在一起的逻辑时钟"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.PartialLogicalClock"
msgid "Number of input connections."
msgstr "输入连接数"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.PartialLogicalClock"
msgid "Vector of Clock input signals."
msgstr "时钟输入信号的向量"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.PartialLogicalClock"
msgid "Replaceable logical combinator applied on vector of Clock input signals.\r\n"
"     Important: Must not be any kind of negation since such would result in\r\n"
"     infinite many ticks for an infinitesimal short time period."
msgstr "应用于时钟输入信号向量的可替换逻辑组合器。\r\n"
"    重要：不得使用任何形式的否定运算，因为这会导致在极短的时间段内产生无限多个时钟脉冲。"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.ConjunctiveClock"
msgid "Logical clock ticking whenever all input clocks ticked at least once, then resets and starts the next conjunctive cycle"
msgstr "逻辑时钟在所有输入时钟至少一次跳变时触发，然后重置并开始下一个联结周期"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.ConjunctiveClock"
msgid "∧"
msgstr "∧"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.ConjunctiveClock"
msgid "<html>\r\n"
"For a simple example cf. the\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.LogicalSample\">logical sampling example</a>.\r\n"
"</html>"
msgstr "<html>\r\n"
"对于一个简单的例子，请参见\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.LogicalSample\">logical sampling example</a>.\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.DisjunctiveClock"
msgid "Logical clock ticking whenever any of its input clock signals ticks."
msgstr "逻辑时钟在任何输入时钟信号跳变时触发"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.DisjunctiveClock"
msgid "∨"
msgstr "∨"

msgctxt "Modelica.Clocked.ClockSignals.Clocks.Logical.DisjunctiveClock"
msgid "<html>\r\n"
"For a simple example cf. the\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.LogicalSample\">logical sampling example</a>.\r\n"
"</html>"
msgstr "<html>\r\n"
"对于一个简单的例子，请参见\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.LogicalSample\">logical sampling example</a>.\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Sampler"
msgid "Library of blocks that sub-, super-, shift-sample clock signals"
msgstr "对时钟信号进行子采样、超采样和移位采样的模块库"

msgctxt "Modelica.Clocked.ClockSignals.Sampler"
msgid "<html>\r\n"
"<p>\r\n"
"This package contains blocks that sub-sample, super-sample, and shift-sample\r\n"
"a clock signal.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"该软件包包含对时钟信号进行子采样、超采样和移位采样的模块。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "Sub-sample the input clock and provide it as output clock"
msgstr "对输入时钟进行子采样，并将其作为输出时钟"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "Sub-sampling factor (>= 1)"
msgstr "子取样系数 (>= 1)"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "Connector of a clock as input signal"
msgstr "时钟输入信号连接器"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "Connector of a clock as output signal (clock y is slower as clock of u)"
msgstr "作为输出信号的时钟连接器（y 时钟比 u 时钟慢）"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "%name"
msgstr "%name"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "%factor"
msgstr "%factor"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SubSample"
msgid "<html>\r\n"
"<p>\r\n"
"This block sub-samples the input clock u and provides it as\r\n"
"output clock y.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"To be more precise:\r\n"
"The clock y is factor-times slower than the clock u. The first activation of clock y coincides with the first activation of clock u. The sub-sampling factor is defined by Integer parameter <strong>factor</strong>.\r\n"
"</p>\r\n"
"\r\n"
"<h4>Example</h4>\r\n"
"\r\n"
"<p>\r\n"
"The following\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.SubSample\">example</a>\r\n"
"generates a periodic clock of 20 ms period, and\r\n"
"then sub-samples the resulting clock signal with a factor of 3:<br>\r\n"
"</p>\r\n"
"\r\n"
"<table border=\"0\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td width=\"50\"></td>\r\n"
"    <td valign=\"bottom\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SubSample_Model.png\" alt=\"SubSample_Model.png\"></td>\r\n"
"    <td valign=\"bottom\">&nbsp;&nbsp;&nbsp;\r\n"
"                        <img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SubSample_Result.png\" alt=\"SubSample_Result.png\"></td>\r\n"
"    </tr>\r\n"
"<tr><td></td>\r\n"
"    <td align=\"center\">model</td>\r\n"
"    <td align=\"center\">simulation result</td>\r\n"
"   </tr>\r\n"
"</table>\r\n"
"<p>\r\n"
"As can be seen, subSample.y picks every third-value of periodicClock.y due to the\r\n"
"sub-sampling, and the sub-sampling factor = 3 is displayed in the icon of the\r\n"
"subSample block. Note the down-arrow in the icon of the subSample block indicates that\r\n"
"clock subSample.y is slower as clock subSample.u.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块对输入时钟 u 进行子采样，并将其作为输出时钟 y 提供。\r\n"
"</p>\r\n"
"<p>\r\n"
"更准确地说： 时钟 y 比时钟 u 慢数倍。 时钟 y 的首次激活时间与时钟 u 的首次激活时间重合。 子采样因子由整数参数 <strong>factor</strong> 定义。\r\n"
"</p>\r\n"
"<h4>Example</h4><p>\r\n"
"以下<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.SubSample\" target=\"\">example</a>&nbsp; 生成一个周期为20毫秒的时钟信号， 然后使用3倍子采样对结果时钟信号进行采样： <br>\r\n"
"</p>\r\n"
"<table style=\"width: auto;\"><tbody><tr><td colSpan=\"1\" rowSpan=\"1\" width=\"50\"></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SubSample_Model.png\" alt=\"SubSample_Model.png\" data-href=\"\" style=\"\"/></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SubSample_Result.png\" alt=\"SubSample_Result.png\" data-href=\"\" style=\"\"/></td></tr><tr><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\">model</td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\">simulation result</td></tr></tbody></table><p>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">如图所示，由于子采样，subSample.y 每次选择 periodicClock.y 的第三个值，并且子采样因子 = 3 显示在 subSample 块的图标中。请注意，subSample 块图标中的向下箭头表示时钟 subSample.y 比时钟 subSample.u 更慢。</span>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "Super-sample the input clock and provide it as output clock"
msgstr "对输入时钟进行超采样，并将其作为输出时钟"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "Super-sampling factor (>= 1)"
msgstr "超采样因子 (>= 1)"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "Connector of a clock as input signal"
msgstr "时钟输入信号连接器"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "Connector of a clock as output signal (clock y is faster as clock of u)"
msgstr "连接时钟作为输出信号（y 时钟与 u 时钟的速度相同）"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "%name"
msgstr "%name"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "%factor"
msgstr "%factor"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.SuperSample"
msgid "<html>\r\n"
"<p>\r\n"
"This block super-samples the clock input signal u and provides it as\r\n"
"clock output signal y.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"To be more precise:\r\n"
"Clock y is factor-times faster than clock u. The first activation of clock y coincides with the first activation of clock u. The super-sampling factor is defined by Integer parameter <strong>factor</strong>.\r\n"
"</p>\r\n"
"\r\n"
"<h4>Example</h4>\r\n"
"\r\n"
"<p>\r\n"
"The following\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.SuperSample\">example</a>\r\n"
"generates a periodic clock of 20 ms period, and\r\n"
"then super-samples the resulting clock with a factor of 3:<br>\r\n"
"</p>\r\n"
"\r\n"
"<table border=\"0\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td width=\"50\"></td>\r\n"
"    <td valign=\"bottom\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SuperSample_Model.png\" alt=\"SuperSample_Model.png\"></td>\r\n"
"    <td valign=\"bottom\">&nbsp;&nbsp;&nbsp;\r\n"
"                        <img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SuperSample_Result.png\" alt=\"SuperSample_Result.png\"></td>\r\n"
"    </tr>\r\n"
"<tr><td></td>\r\n"
"    <td align=\"center\">model</td>\r\n"
"    <td align=\"center\">simulation result</td>\r\n"
"   </tr>\r\n"
"</table>\r\n"
"<p>\r\n"
"As can be seen, superSample introduces factor-1 additional clock ticks for the\r\n"
"output clock y. The super-sampling factor = 3 is displayed in the icon of the\r\n"
"superSample block. Note the up-arrow in the icon of the superSample block indicates that\r\n"
"clock superSample.y is faster as clock superSample.u.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html><p>\r\n"
"该模块对时钟输入信号 u 进行超采样，并将其作为时钟输出信号 y 提供。\r\n"
"</p>\r\n"
"<p>\r\n"
"更准确地说： 时钟 y 的速度是时钟 u 的数倍。 时钟 y 的首次激活时间与时钟 u 的首次激活时间重合。 超采样因子由整数参数 <strong>factor</strong> 定义。\r\n"
"</p>\r\n"
"<h4>Example</h4><p>\r\n"
"下面的<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.SuperSample\" target=\"\">example</a>&nbsp; 生成了一个周期为 20 毫秒的周期时钟，然后对生成的时钟进行了 3 倍的超采样： <br>\r\n"
"</p>\r\n"
"<table style=\"width: auto;\"><tbody><tr><td colSpan=\"1\" rowSpan=\"1\" width=\"50\"></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SuperSample_Model.png\" alt=\"SuperSample_Model.png\" data-href=\"\" style=\"\"/></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/SuperSample_Result.png\" alt=\"SuperSample_Result.png\" data-href=\"\" style=\"\"/></td></tr><tr><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\">model</td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\">simulation result</td></tr></tbody></table><p>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">如图所示，superSample 为输出时钟 y 引入了一个额外的因子-1 时钟滴答。超采样因子 = 3 显示在 superSample 块的图标中。请注意，superSample 块图标中的向上箭头表示时钟 superSample.y 比时钟 superSample.u 更快。</span>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "Shift the input clock by a fraction of the last interval and provide it as output clock"
msgstr "将输入时钟按最后一个间隔的一个分数进行偏移，并将其作为输出时钟提供"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "Numerator of shifting formula"
msgstr "移位公式的分子"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "Shift first clock activation for 'shiftCounter/resolution*interval(u)' seconds"
msgstr "将第一个时钟激活时间移至'移位计数器/分辨率*间隔(u)'秒"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "Denominator of shifting formula"
msgstr "移位公式的分母"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "Connector of clock input signal"
msgstr "时钟输入信号连接器"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "Connector of clock output signal"
msgstr "时钟输出信号连接器"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "%name"
msgstr "%name"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "%shiftCounter/%resolution"
msgstr "%shiftCounter/%resolution"

msgctxt "Modelica.Clocked.ClockSignals.Sampler.ShiftSample"
msgid "<html>\r\n"
"<p>\r\n"
"This block shifts the first activation of clock output y by\r\n"
"fraction shiftCounter/resolution of the period (or for a non-periodic signal by a fraction of the last interval).\r\n"
"Here, <strong>shiftCounter</strong> and <strong>resolution</strong> are positive Integer parameters.\r\n"
"</p>\r\n"
"\r\n"
"<p>\r\n"
"To be more precise:\r\n"
"The block constructs (conceptually) a clock &ldquo;cBase&rdquo;\r\n"
"</p>\r\n"
"\r\n"
"<blockquote><pre>\r\n"
"<strong>Clock</strong> cBase = <strong>subSample</strong>(<strong>superSample</strong>(u, resolution), shiftCounter)\r\n"
"</pre></blockquote>\r\n"
"\r\n"
"<p>\r\n"
"and clock y starts at the second clock tick of cBase.\r\n"
"</p>\r\n"
"\r\n"
"<h4>Example</h4>\r\n"
"\r\n"
"<p>\r\n"
"The following\r\n"
"<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.ShiftSample\">example</a>\r\n"
"generates a periodic clock of 20 ms period, and\r\n"
"then shifts it with shiftCounter = 4 and resolution = 3:<br>\r\n"
"</p>\r\n"
"\r\n"
"<table border=\"0\" cellspacing=\"0\" cellpadding=\"2\">\r\n"
"<tr><td width=\"50\"></td>\r\n"
"    <td valign=\"bottom\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/ShiftSample_Model.png\" alt=\"ShiftSample_Model.png\"></td>\r\n"
"    <td valign=\"bottom\">&nbsp;&nbsp;&nbsp;\r\n"
"                        <img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/ShiftSample_Result.png\" alt=\"ShiftSample_Result.png\"></td>\r\n"
"    </tr>\r\n"
"<tr><td></td>\r\n"
"    <td align=\"center\">model</td>\r\n"
"    <td align=\"center\">simulation result</td>\r\n"
"   </tr>\r\n"
"</table>\r\n"
"<p>\r\n"
"The first activation of clock output y of block shiftSample1 is shifted in time (4/3*20ms). The parameter values <strong>shiftCounter</strong> = 4 and <strong>resolution</strong> = 3 are visible at the bottom of the icon.\r\n"
"</p>\r\n"
"\r\n"
"</html>"
msgstr "<html><p>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">该块将时钟输出 y 的第一次激活按照周期的分数 shiftCounter/resolution 进行偏移（对于非周期信号，则按最后一个间隔的分数进行偏移）。其中，</span><span style=\"color: rgb(51, 51, 51);\"><strong>shiftCounter </strong></span><span style=\"color: rgb(51, 51, 51);\">和 </span><span style=\"color: rgb(51, 51, 51);\"><strong>resolution </strong></span><span style=\"color: rgb(51, 51, 51);\">是正整数参数。</span>\r\n"
"</p>\r\n"
"<p>\r\n"
"<span style=\"color: rgb(51, 51, 51);\">更准确地说：该块（从概念上）构建了一个时钟“cBase”，</span>\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<pre><code >Clock cBase = subSample(superSample(u, resolution), shiftCounter)\r\n"
"</code></pre><p>\r\n"
"<br>\r\n"
"</p>\r\n"
"<p>\r\n"
"和时钟 y 从 cBase 的第二个时钟刻度开始。\r\n"
"</p>\r\n"
"<h4>Example</h4><p>\r\n"
"下面的<a href=\"modelica://Modelica.Clocked.Examples.Elementary.ClockSignals.ShiftSample\" target=\"\">example</a>&nbsp; 生成了一个周期为 20 ms 的周期时钟， 然后使用 shiftCounter = 4 和 resolution = 3 对其进行移位： <br>\r\n"
"</p>\r\n"
"<table style=\"width: auto;\"><tbody><tr><td colSpan=\"1\" rowSpan=\"1\" width=\"50\"></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/ShiftSample_Model.png\" alt=\"ShiftSample_Model.png\" data-href=\"\" style=\"\"/></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"><img src=\"modelica://Modelica/Resources/Images/Clocked/ClockSignals/ShiftSample_Result.png\" alt=\"ShiftSample_Result.png\" data-href=\"\" style=\"\"/></td></tr><tr><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\"></td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\">model</td><td colSpan=\"1\" rowSpan=\"1\" width=\"auto\">simulation result</td></tr></tbody></table><p>\r\n"
"shiftSample1 模块的时钟输出y的第一个激活在时间上被移位了（4/3 * 20ms）。 参数值 <strong>shiftCounter</strong> = 4 和 <strong>resolution</strong> = 3显示在图标底部。\r\n"
"</p>\r\n"
"<p>\r\n"
"<br>\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "Library of connectors and partial blocks with clock signals"
msgstr "带时钟信号的连接器和部分模块库"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "<html>\r\n"
"<p>\r\n"
"This package contains clock connectors, as well as partial blocks that are used to\r\n"
"construct clock blocks.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"这个软件包包含时钟连接器，以及部分模块用于构建时钟模块。</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "'input Clock' as connector"
msgstr "'输入时钟'作为连接器"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "<html>\r\n"
"<p>\r\n"
"Connector with one input signal of type Clock.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"带有一个时钟类型输入信号的连接器。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "'output Clock' as connector"
msgstr "'输出时钟'作为连接器"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "<html>\r\n"
"<p>\r\n"
"Connector with one output signal of type Clock.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"带有一个时钟类型输出信号的连接器。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "Clock input connector used for vector of connectors."
msgstr "用于连接矢量的时钟输入连接器"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces"
msgid "<html>\r\n"
"<p>\r\n"
"Clock input connector that is used for a vector of connectors and therefore has\r\n"
"a different icon as <code>ClockInput</code> connector.\r\n"
"</p>\r\n"
"</html>"
msgstr "<html>\r\n"
"<p>\r\n"
"时钟输入连接器用于连接一组连接器，因此具有不同的图标，称为 <code>ClockInput</code> 连接器。\r\n"
"</p>\r\n"
"</html>"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces.PartialClock"
msgid "Icon, connector, and solver method of a block that generates a clock"
msgstr "生成时钟的程序模块的图标、连接器和求解器方法"

msgctxt "Modelica.Clocked.ClockSignals.Interfaces.PartialClock"
